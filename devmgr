      <button type="button" class="nav-destination" id="tab-blacklist" aria-selected="false">
        <div class="nav-pill" aria-hidden="true">🚫</div>
        <span class="nav-label">Blacklist (<span id="cnt-blk">0</span>)</span>
      </button>
    </nav>

    <div class="main-pane">
      <!-- M3 Small Top App Bar -->
      <header class="top-app-bar">
        <div class="headline-wrap">
          <div class="router-badge" aria-hidden="true">📡</div>
          <div class="headline-text">
            <h1 class="headline-title">
              <span>Xiaomi CR6608</span>
              <span class="conn-indicator" id="sync-badge" role="status">● Trực tuyến</span>
            </h1>
            <span class="headline-sub" id="sub-status">Đang đồng bộ danh sách thiết bị...</span>
          </div>
        </div>
        <div class="app-bar-actions">
          <button type="button" class="tonal-btn-m3" id="btn-poll" aria-label="Đổi chu kỳ làm mới">⏱ 5s</button>
          <button type="button" class="icon-btn-m3" id="btn-theme" aria-label="Đổi giao diện Sáng hoặc Tối">🌓</button>
          <button type="button" class="icon-btn-m3" id="btn-settings" aria-label="Cài đặt và Quản trị Router">⚙️</button>
          <button type="button" class="icon-btn-m3" id="btn-refresh" aria-label="Làm mới dữ liệu ngay">↻</button>
        </div>
      </header>

      <!-- Recovery Error Banner (Shown only when fetch fails) -->
