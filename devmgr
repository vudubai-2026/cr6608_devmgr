          });
          if (d.online && d.ip) mkBtn('📢 GỬI THÔNG BÁO', 'warn', () => openNotifyModal(d));
          mkBtn('✎ ĐỔI TÊN MÁY', 'soft', () => openRename(d));
          mkBtn('⏱ GIỚI HẠN QOS', 'soft', () => openQosModal(d));
          if (d.ip) mkBtn('🔒 GÁN IP CỐ ĐỊNH', 'soft', () => postAction({ action: 'static_lease', mac: d.mac, ip: d.ip }));
          mkBtn('⚡ WAKE-ON-LAN', 'soft', () => postAction({ action: 'wol', mac: d.mac }));
          if (d.online && d.band !== 'LAN') mkBtn('👢 KICK WI-FI', 'danger', () => postAction({ action: 'kick', mac: d.mac }).then(ok => ok && fetchList()));
          body.appendChild(actGrid);
        }
      });
    }

    function openNotifyModal(d) {
      const prof = resolveProfile(d);
      openModal({
        title: '📢 GỬI THÔNG BÁO TỚI ĐT',
        desc: `Chuyển hướng HTTP (port 80) của "${prof.name}" (${d.ip}) về trang thông báo trong 30s (không ngắt Internet):`,
        okText: 'GỬI NGAY',
        okClass: 'accent',
        buildBody: body => {
          const presets = [
            '⏰ Đến giờ nghỉ ngơi rồi!',
            '🍽️ Xuống ăn cơm thôi!',
            '📶 Wi-Fi sắp bảo trì 5 phút',
            '📞 Bố/Mẹ đang gọi điện thoại!'
          ];
          const pWrap = document.createElement('div');
          pWrap.style.cssText = 'display:flex;gap:5px;flex-wrap:wrap;margin-bottom:8px';
          presets.forEach(txt => {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'px-btn soft'; b.style.fontSize = '10px';
            b.textContent = txt;
            b.onclick = () => { inp.value = txt; };
            pWrap.appendChild(b);
          });

          const inp = document.createElement('input');
          inp.className = 'px-input'; inp.maxLength = 120; inp.id = 'inp-notify';
          inp.placeholder = 'Nhập nội dung thông báo...';
          inp.value = presets[0];

          const hint = document.createElement('div');
          hint.className = 'px-font';
          hint.style.cssText = 'font-size:10.5px;color:var(--text-dim);margin-bottom:4px';
          hint.textContent = `Trang đích: http://${location.hostname || '192.168.2.1'}/notice.html`;

          body.append(pWrap, inp, hint);
          setTimeout(() => inp.focus(), 50);
        },
        onOk: () => {
          const msg = $('inp-notify').value.trim();
          if (!msg) return toast('VUI LÒNG NHẬP NỘI DUNG');
          postAction({ action: 'notify', mac: d.mac, ip: d.ip, message: msg });
        }
      });
    }

    function openRename(d) {
      const prof = resolveProfile(d);
      openModal({
        title: 'ĐỔI TÊN THIẾT BỊ',
        desc: `Lưu tên trên Router cho [${d.mac}] (xóa trống để bỏ tên tự đặt):`,
        okText: 'LƯU TÊN',
        okClass: 'accent',
        buildBody: body => {
          const inp = document.createElement('input');
          inp.className = 'px-input'; inp.maxLength = 32; inp.id = 'inp-rename';
          inp.value = (d.name || '').trim();
          inp.placeholder = prof.name;
          body.appendChild(inp);
          setTimeout(() => inp.focus(), 50);
        },
        onOk: () => {
          const val = $('inp-rename').value.trim();
          if (val !== (d.name || '').trim()) {
            postAction({ action: 'rename', mac: d.mac, name: val }).then(ok => ok && fetchList());
          }
        }
      });
    }

    function openQosModal(d) {
      const curRate = Number(d.qos_rate || 0);
      openModal({
        title: 'GIỚI HẠN BĂNG THÔNG (QOS)',
        desc: `Tốc độ tối đa (KB/s) cho "${resolveProfile(d).name}". Nhập 0 để gỡ, tối thiểu 16 KB/s:`,
        okText: 'ÁP DỤNG',
        okClass: 'accent',
        buildBody: body => {
          const inp = document.createElement('input');
          inp.type = 'number'; inp.min = '0'; inp.step = '16'; inp.className = 'px-input'; inp.id = 'inp-qos';
          inp.value = curRate;
          const pRow = document.createElement('div');
          pRow.style.cssText = 'display:flex;gap:5px;flex-wrap:wrap;margin-bottom:8px';
          [[0,'GỠ (0)'],[512,'512 KB/S'],[1024,'1 MB/S'],[3072,'3 MB/S'],[5120,'5 MB/S']].forEach(([v, l]) => {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'px-btn soft'; b.textContent = l;
            b.onclick = () => { inp.value = v; };
            pRow.appendChild(b);
          });
          body.append(pRow, inp);
        },
        onOk: () => {
          const raw = parseInt($('inp-qos').value || '0', 10);
          const rate = raw <= 0 ? 0 : Math.max(16, raw);
          if (rate !== curRate) {
            postAction({ action: 'qos_limit', mac: d.mac, rate }).then(ok => ok && fetchList());
          }
        }
      });
    }

    function openIconPicker(mac, cur) {
      let chosen = cur;
      openModal({
        title: 'CHỌN BIỂU TƯỢNG',
        desc: `Biểu tượng hiển thị cho [${mac}]:`,
        okText: 'LƯU',
        okClass: 'accent',
        buildBody: body => {
          const g = document.createElement('div');
          g.className = 'icon-grid';
          ICONS.forEach(ic => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = `icon-opt ${ic === cur ? 'sel' : ''}`;
            b.textContent = ic;
            b.onclick = () => {
              g.querySelectorAll('.icon-opt').forEach(x => x.classList.remove('sel'));
              b.classList.add('sel');
              chosen = ic;
            };
            g.appendChild(b);
          });
          body.appendChild(g);
        },
        onOk: () => {
          state.prefs.icons[mac] = chosen;
          savePrefs(); render(); toast(`ĐÃ ĐỔI BIỂU TƯỢNG ${chosen}`);
        }
      });
    }

    function openAddMac() {
      openModal({
        title: 'THÊM VÀO BLACKLIST',
        desc: 'Nhập địa chỉ MAC cần cấm kết nối vĩnh viễn:',
        okText: 'CHẶN MAC',
        okClass: 'danger',
        buildBody: body => {
          const inp = document.createElement('input');
          inp.className = 'px-input'; inp.maxLength = 17; inp.id = 'inp-mac';
          inp.placeholder = 'AA:BB:CC:DD:EE:FF';
          body.appendChild(inp);
          setTimeout(() => inp.focus(), 50);
        },
        onOk: () => {
          const mac = $('inp-mac').value.trim().toUpperCase();
          if (/^([0-9A-F]{2}[:-]){5}([0-9A-F]{2})$/.test(mac)) {
            postAction({ action: 'blacklist_add', mac }).then(ok => ok && fetchList());
          } else {
            toast('ĐỊA CHỈ MAC KHÔNG HỢP LỆ');
          }
        }
      });
    }

    function openToolsModal() {
      openModal({
        title: 'CÔNG CỤ & HỆ THỐNG',
        desc: 'Quản lý dữ liệu cài đặt, chọn nhiều thiết bị hoặc khởi động lại CR6608:',
        showOk: false,
        buildBody: body => {
          const selBtn = document.createElement('button');
          selBtn.type = 'button'; selBtn.className = 'px-btn soft'; selBtn.style.cssText = 'width:100%;height:38px;margin-bottom:8px';
          selBtn.textContent = '☑️ BẬT CHẾ ĐỘ CHỌN NHIỀU HÀNG LOẠT';
          selBtn.onclick = () => { closeDlg(); enterSelectMode(null); };

          const expBtn = document.createElement('button');
          expBtn.type = 'button'; expBtn.className = 'px-btn accent'; expBtn.style.cssText = 'width:100%;height:38px;margin-bottom:8px';
          expBtn.textContent = '📤 XUẤT CÀI ĐẶT (.JSON)';
          expBtn.onclick = () => {
            const blob = new Blob([JSON.stringify(state.prefs, null, 2)], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `cr6608-pixel-v5-${new Date().toISOString().slice(0,10)}.json`;
            a.click();
            URL.revokeObjectURL(a.href);
            toast('ĐÃ XUẤT FILE CẤU HÌNH JSON');
          };

          const impInp = document.createElement('input');
          impInp.type = 'file'; impInp.accept = '.json,application/json'; impInp.style.display = 'none';
          impInp.onchange = e => {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = () => {
              try {
                const parsed = JSON.parse(String(reader.result));
                if (typeof parsed !== 'object' || !parsed) throw new Error();
                state.prefs = { ...defaultPrefs, ...parsed };
                savePrefs(); applyTheme(); renderGroupChips(); render(); closeDlg();
                toast('ĐÃ KHÔI PHỤC CÀI ĐẶT');
              } catch (err) {
                toast('FILE JSON KHÔNG HỢP LỆ');
              }
            };
            reader.readAsText(file);
          };

          const impBtn = document.createElement('button');
          impBtn.type = 'button'; impBtn.className = 'px-btn soft'; impBtn.style.cssText = 'width:100%;height:38px;margin-bottom:14px';
          impBtn.textContent = '📥 NHẬP CÀI ĐẶT TỪ JSON';
          impBtn.onclick = () => impInp.click();

          const rebBtn = document.createElement('button');
          rebBtn.type = 'button'; rebBtn.className = 'px-btn danger'; rebBtn.style.cssText = 'width:100%;height:38px';
          rebBtn.textContent = '🔄 KHỞI ĐỘNG LẠI ROUTER CR6608';
          rebBtn.onclick = () => {
            openConfirm('XÁC NHẬN BƯỚC 1/2', 'Router sẽ ngắt mạng trong khoảng 1 phút. Tiếp tục?', () => {
              setTimeout(() => {
                openConfirm('XÁC NHẬN CUỐI CÙNG (2/2)', 'Bạn chắc chắn muốn KHỞI ĐỘNG LẠI router ngay bây giờ?', () => {
                  postAction({ action: 'reboot' });
                });
              }, 120);
            });
          };

          body.append(selBtn, expBtn, impInp, impBtn, rebBtn);
        }
      });
    }

    /* ==========================================================================
       INITIALIZATION
       ========================================================================== */
    (function init() {
      applyTheme();
      renderGroupChips();
      updateClock();
      setInterval(updateClock, 15000);

      if (!DEMO_MODE) {
        try {
          const cached = JSON.parse(localStorage.getItem(CACHE_KEY) || 'null');
          if (cached && Array.isArray(cached.devices)) {
            state.sys = cached.sys || null;
            state.devices = cached.devices;
            processIncomingDevices(state.devices);
            render();
          }
        } catch (e) {}
      }

      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (state.prefs.theme === 'auto') applyTheme();
      });

      $('btn-theme').onclick = () => {
        vibrate();
        const curDark = document.documentElement.dataset.theme === 'dark';
        state.prefs.theme = curDark ? 'light' : 'dark';
        savePrefs();
        applyTheme();
      };

      $('btn-poll').onclick = () => {
        vibrate();
        const cycle = [5000, 10000, 30000, 0];
        const next = cycle[(cycle.indexOf(state.prefs.pollMs) + 1) % cycle.length];
        state.prefs.pollMs = next;
        savePrefs();
        applyTheme();
        scheduleNextPoll();
        toast(next === 0 ? 'CHẾ ĐỘ LÀM MỚI THỦ CÔNG' : `TỰ LÀM MỚI MỖI ${next / 1000} GIÂY`);
      };

      $('btn-tools').onclick = () => { vibrate(); openToolsModal(); };
      $('btn-refresh').onclick = () => { vibrate(); toast('ĐANG CẬP NHẬT...'); fetchList(); };
      $('btn-retry').onclick = fetchList;
      $('fab-add').onclick = () => { vibrate(); openAddMac(); };

      $('bulk-block').onclick = () => runBulkAction('block');
      $('bulk-unblock').onclick = () => runBulkAction('unblock');
      $('bulk-kick').onclick = () => runBulkAction('kick');
      $('bulk-exit').onclick = exitSelectMode;

      let sTimer = null;
      const searchInp = $('search');
      const clearBtn = $('search-clear');
      searchInp.oninput = e => {
        clearBtn.style.display = e.target.value ? 'inline-flex' : 'none';
        clearTimeout(sTimer);
        sTimer = setTimeout(() => {
          state.query = e.target.value.trim().toLowerCase();
          render();
        }, 100);
      };
      clearBtn.onclick = () => {
        searchInp.value = '';
        clearBtn.style.display = 'none';
        state.query = '';
        render();
      };

      $('filter-row').onclick = e => {
        const c = e.target.closest('.px-chip[data-f]');
        if (!c) return;
        vibrate();
        $('filter-row').querySelectorAll('.px-chip[data-f]').forEach(x => x.classList.remove('active'));
        c.classList.add('active');
        state.filter = c.dataset.f;
        render();
      };

      $('sort-row').onclick = e => {
        const c = e.target.closest('.px-chip[data-s]');
        if (!c) return;
        vibrate();
        $('sort-row').querySelectorAll('.px-chip[data-s]').forEach(x => x.classList.remove('active'));
        c.classList.add('active');
        state.sort = c.dataset.s;
        render();
      };

      $('tab-clients').onclick = () => {
        if (state.tab === 'clients') return;
        vibrate(); state.tab = 'clients';
        $('tab-clients').classList.add('active');
        $('tab-blacklist').classList.remove('active');
        render();
      };
      $('tab-blacklist').onclick = () => {
        if (state.tab === 'blacklist') return;
        vibrate(); state.tab = 'blacklist';
        $('tab-blacklist').classList.add('active');
        $('tab-clients').classList.remove('active');
        render();
      };

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') fetchList();
        else if (state.timer) { clearTimeout(state.timer); state.timer = null; }
      });

      fetchList();
    })();
  </script>
</body>
</html>
