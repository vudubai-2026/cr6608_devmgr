  <div id="toast-box"></div>

  <!-- 30s Inactivity Auto-Close / Sleep Overlay -->
  <div class="idle-screen" id="idle-screen" hidden>
    <div class="idle-box">
      <div class="dlg-titlebar"><span>[ IDLE.30S ]</span><span>[ ZZ ]</span></div>
      <div class="dlg-inner">
        <h3 class="dlg-title" id="idle-title">Đã tạm đóng phiên (30s)</h3>
        <p class="dlg-desc" id="idle-desc">Ngắt kết nối nền để tiết kiệm pin và tài nguyên Router.</p>
        <button type="button" class="btn-sm tonal" id="btn-wake" style="width:100%;padding:8px">↻ MỞ LẠI QUẢN LÝ</button>
      </div>
    </div>
  </div>

  <script>
    /**
     * Xiaomi CR6608 Device Manager v5.4
     * Styles: Pixel (Default, LuCI Pixel Port) | Material 3 | iOS Liquid Glass
     * Single-file Vanilla JS | Zero External Deps | Diff DOM
     */
    const DEMO_MODE = false;
    const API = '/cgi-bin/devmgr';
    const IDLE_TIMEOUT_MS = 30000;
    const STORAGE_KEY = 'cr6608_v54_prefs';
    const KNOWN_KEY = 'cr6608_v54_known';

    const ICONS = ['📱','💻','🖥️','📺','📟','🎮','💡','📷','🤖','🔊','⌚','🔌','🖨️','📡','🚗','🔒','❄️','🧹','📻','🚪','🛎️','🌐','📦','🏷️'];
    const DEFAULT_GROUPS = ['Gia đình', 'Khách', 'IoT'];

    const OUI_MAP = new Map([
      ['F0:99:BF','Apple'],['AC:BC:32','Apple'],['F4:F5:DB','Apple'],['DC:A9:04','Apple'],
      ['B4:FB:E4','Xiaomi'],['7C:49:EB','Xiaomi'],['64:90:C1','Xiaomi'],['28:6C:07','Xiaomi'],
      ['50:EC:50','Samsung'],['BC:24:11','Samsung'],['34:C9:F0','Samsung'],
      ['84:F3:EB','Espressif'],['EC:FA:BC','Espressif'],['A4:CF:12','Espressif'],
      ['D8:3A:DD','Raspberry Pi'],['B8:27:EB','Raspberry Pi'],['E4:5F:01','Raspberry Pi'],
      ['00:1A:7D','Sony'],['FC:0F:E6','Sony'],['70:66:55','TP-Link'],
      ['38:F8:89','Huawei'],['70:54:F5','Huawei']
    ]);

    const I18N_MAP = {
      errConn: 'Mất kết nối tới Router CR6608',
      retry: 'Thử lại',
      sysTitle: '📊 Tình trạng Router CR6608',
      detailMore: 'Chi tiết ▾',
      cpuLoad: 'CPU Load',
      ramUsed: 'RAM dùng',
      uptime: 'Uptime',
      clients: 'Clients',
      dlLbl: 'Tải xuống',
      ulLbl: 'Tải lên',
      onlineLbl: 'Online',
      top3Lbl: '🔥 Top 3:',
      fAll: 'Tất cả',
      f5g: '5GHz',
      f2g: '2.4GHz',
      fLan: 'LAN',
      fBlocked: 'Đang chặn',
      fWeak: 'Sóng yếu',
      sortLbl: 'Sắp xếp:',
      sDef: 'Mặc định',
      sSpd: '⚡ Tốc độ',
      sName: '🔤 Tên',
      sNew: '🆕 Mới nhất',
      emptyTxt: 'Không có thiết bị nào phù hợp.',
      actBlock: 'Chặn',
      actUnblock: 'Bỏ chặn',
      fabBlockMac: 'Chặn MAC',
      tabConn: 'Kết nối',
      btnClose: 'Đóng',
      btnConfirm: 'Xác nhận'
    };

    const domRegistry = new Map();
    const speedHistory = new Map();

    const defaultPrefs = {
      theme: 'auto',      // auto -> dark -> light
      style: 'pixel',     // pixel (default) -> m3 -> glass
      pollMs: 5000,       // 5000 -> 10000 -> 30000 -> 0
      icons: {},
      pinned: [],
      groups: {},
      customGroups: []
    };

    const state = {
      prefs: loadPrefs(),
      devices: [],
      sys: null,
      tab: 'clients',
      filter: 'all',
      groupFilter: '',
      sort: 'default',
      query: '',
      writing: false,
      timer: null,
      backoff: 5000,
      errors: 0,
      known: null,
      sessionNew: new Set(),
      firstOrder: new Map(),
      selectMode: false,
      selected: new Set(),
      isIdle: false,
      idleTimer: null
    };

    const $ = id => document.getElementById(id);
    const vibrate = (ms = 16) => navigator.vibrate && navigator.vibrate(ms);

    // Strip Vietnamese diacritics ONLY when Pixel style is active (Pixel5x7 font safety)
    function stripDiacritics(str) {
      return String(str)
        .replace(/đ/g, 'd').replace(/Đ/g, 'D')
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function uiTxt(str) {
      if (state.prefs.style !== 'pixel') return str;
      // Strip emoji & diacritics for crisp 5x7 pixel labels
      return stripDiacritics(str).replace(/[^\x20-\x7E]/g, '').trim();
    }

    function loadPrefs() {
      try {
        const raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        return {
          theme: ['auto', 'dark', 'light'].includes(raw.theme) ? raw.theme : 'auto',
          style: ['pixel', 'm3', 'glass'].includes(raw.style) ? raw.style : 'pixel',
          pollMs: typeof raw.pollMs === 'number' ? raw.pollMs : 5000,
          icons: raw.icons || {},
          pinned: Array.isArray(raw.pinned) ? raw.pinned : [],
          groups: raw.groups || {},
          customGroups: Array.isArray(raw.customGroups) ? raw.customGroups : []
        };
      } catch (e) {
        return { ...defaultPrefs };
      }
    }

    function savePrefs() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state.prefs));
    }

    function syncStaticTexts() {
      const isPx = state.prefs.style === 'pixel';
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.dataset.i18n;
        if (I18N_MAP[key]) {
          el.textContent = isPx ? uiTxt(I18N_MAP[key]).toUpperCase() : I18N_MAP[key];
        }
      });
      $('search').placeholder = isPx
        ? 'TIM TEN, IP, MAC, HANG, NHOM...'
        : 'Tìm tên, IP, MAC, hãng, nhóm...';
      $('idle-title').textContent = isPx ? 'DA TAM DONG PHIEN (30S)' : 'Đã tạm đóng phiên (30s)';
      $('idle-desc').textContent = isPx ? 'NGAT KET NOI NEN DE TIET KIEM PIN.' : 'Ngắt kết nối nền để tiết kiệm pin và tài nguyên Router.';
      $('btn-wake').textContent = isPx ? 'MO LAI QUAN LY' : '↻ Mở lại quản lý';
    }

    function typePixelSubtitle() {
      const el = $('px-sub');
      if (state.prefs.style !== 'pixel') {
        el.textContent = '';
        return;
      }
      const phrase = 'DEVMGR //';
      let idx = 0;
      el.textContent = '';
      const iv = setInterval(() => {
        idx++;
        el.textContent = phrase.slice(0, idx);
        if (idx >= phrase.length) {
          clearInterval(iv);
          const cur = document.createElement('span');
          cur.className = 'px-cursor';
          el.appendChild(cur);
        }
      }, 55);
    }

    function applyAppearance() {
      const sysDark = matchMedia('(prefers-color-scheme: dark)').matches;
      const activeTheme = state.prefs.theme === 'auto' ? (sysDark ? 'dark' : 'light') : state.prefs.theme;
      document.documentElement.dataset.theme = activeTheme;
      document.documentElement.dataset.style = state.prefs.style;
      document.body.dataset.style = state.prefs.style;

      if (state.prefs.style === 'pixel') {
        $('meta-theme').content = activeTheme === 'dark' ? '#0B0C0B' : '#E2E3E0';
        $('btn-style').textContent = 'PIXEL';
      } else if (state.prefs.style === 'glass') {
        $('meta-theme').content = activeTheme === 'dark' ? '#0B1221' : '#E4EEFF';
        $('btn-style').textContent = '🫧 Glass';
      } else {
        $('meta-theme').content = activeTheme === 'dark' ? '#111318' : '#F8F9FF';
        $('btn-style').textContent = '✨ M3';
      }

      const thLbl = state.prefs.theme === 'auto' ? 'Auto' : state.prefs.theme === 'dark' ? 'Tối' : 'Sáng';
      $('btn-theme').textContent = state.prefs.style === 'pixel' ? uiTxt(thLbl).toUpperCase() : `🌓 ${thLbl}`;

      const pSec = state.prefs.pollMs === 0 ? (state.prefs.style === 'pixel' ? 'TAY' : 'Tay') : (state.prefs.pollMs / 1000) + 's';
      $('btn-poll').textContent = state.prefs.style === 'pixel' ? pSec.toUpperCase() : `⏱ ${pSec}`;

      syncStaticTexts();
      renderGroupChips();
      // Force card cache invalidation when switching between Pixel & M3/Glass
      for (const ref of domRegistry.values()) ref.cache = {};
      render();
    }

    function toast(msg) {
      const box = $('toast-box');
      const el = document.createElement('div');
      el.className = 'toast';
      el.textContent = state.prefs.style === 'pixel' ? uiTxt(msg).toUpperCase() : msg;
      box.appendChild(el);
      setTimeout(() => el.remove(), 2400);
    }

    function copyText(txt, lbl) {
      vibrate();
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(txt).then(() => toast(`Đã chép ${lbl}: ${txt}`));
      } else {
        const i = document.createElement('input');
        i.value = txt; document.body.appendChild(i); i.select();
        document.execCommand('copy'); i.remove();
        toast(`Đã chép ${lbl}: ${txt}`);
      }
    }

    function fmtSpeed(b) {
      if (!b || b <= 0) return '0 B/s';
      if (b < 1024) return b + ' B/s';
      if (b < 1048576) return (b / 1024).toFixed(1) + ' KB/s';
      return (b / 1048576).toFixed(2) + ' MB/s';
    }

    function fmtBytes(b) {
      if (!b || b <= 0) return '0 B';
      if (b < 1024) return b + ' B';
      if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
      if (b < 1073741824) return (b / 1048576).toFixed(2) + ' MB';
      return (b / 1073741824).toFixed(2) + ' GB';
    }

    function fmtUptime(sec) {
      if (!sec || sec <= 0) return '-';
      const d = Math.floor(sec / 86400);
      const h = Math.floor((sec % 86400) / 3600);
      const m = Math.floor((sec % 3600) / 60);
      return d > 0 ? `${d}d ${h}h` : `${h}h ${m}m`;
    }

    function fmtLastSeen(unixSec) {
      if (!unixSec || unixSec <= 0) return '';
      const diff = Math.max(1, Math.floor(Date.now() / 1000) - unixSec);
      if (diff < 60) return uiTxt('Thấy lần cuối vừa xong');
      if (diff < 3600) return uiTxt(`Thấy lần cuối ${Math.floor(diff / 60)} phút trước`);
      if (diff < 86400) return uiTxt(`Thấy lần cuối ${Math.floor(diff / 3600)} giờ trước`);
      return uiTxt(`Thấy lần cuối ${Math.floor(diff / 86400)} ngày trước`);
    }

    function fmtQos(kbps) {
      if (!kbps || kbps <= 0) return '';
      return kbps >= 1024 ? (kbps / 1024).toFixed(1).replace(/\.0$/, '') + ' MB/s' : kbps + ' KB/s';
    }

    function isRandomMac(mac) {
      const b = parseInt((mac || '').slice(0, 2), 16);
      return !isNaN(b) && Boolean(b & 0x02);
    }

    function isGarbageHostname(h) {
      if (!h) return true;
      const s = h.trim();
      return !s || s === '*' || s === '?' || s === 'localhost' || /^android-[0-9a-f]{6,}$/i.test(s);
    }

    function resolveProfile(d) {
      const mac = (d.mac || '').toUpperCase();
      const rand = isRandomMac(mac);
      const last4 = mac.replace(/[:-]/g, '').slice(-4);
      let vendor = rand ? '' : ((d.vendor || '').trim() || OUI_MAP.get(mac.slice(0, 8)) || '');

      let name = (d.name || '').trim();
      if (!name) {
        const host = isGarbageHostname(d.hostname) ? '' : d.hostname.trim();
        if (host) name = host;
        else if (vendor) name = `${vendor} · ${last4}`;
        else if (rand) name = state.prefs.style === 'pixel' ? `Thiet bi rieng tu - ${last4}` : `Thiết bị riêng tư · ${last4}`;
        else name = state.prefs.style === 'pixel' ? 'Khong ro' : 'Không rõ';
      }

      let icon = state.prefs.icons[mac];
      if (!icon) {
        const hint = (name + ' ' + vendor).toLowerCase();
        if (d.band === 'LAN') icon = '🖥️';
        else if (/tv|tivi|bravia/.test(hint)) icon = '📺';
        else if (/esp|iot|cam|light|plug|vacuum/.test(hint)) icon = '💡';
        else if (/ipad|tab/.test(hint)) icon = '📟';
        else if (/macbook|laptop|pc|desktop|thinkpad/.test(hint)) icon = '💻';
        else icon = '📱';
      }
      return { name, vendor, icon, rand };
    }

    // Stepped staircase sparkline in Pixel mode, smooth polyline in M3/Glass
    function buildSparkPoints(mac) {
      const arr = speedHistory.get(mac);
      if (!arr || arr.length < 2) return '';
      const max = Math.max(1024, ...arr);
      const w = 68, h = 22;
      const step = w / (arr.length - 1);
      const isPx = state.prefs.style === 'pixel';
      const pts = [];
      arr.forEach((v, i) => {
        const x = (i * step).toFixed(1);
        const y = (h - (v / max) * (h - 3) - 1.5).toFixed(1);
        if (isPx && i > 0) {
          const prevY = pts[pts.length - 1].split(',')[1];
          pts.push(`${x},${prevY}`);
        }
        pts.push(`${x},${y}`);
      });
      return pts.join(' ');
    }

    function createTag(text, cls) {
      const sp = document.createElement('span');
      sp.className = `tag ${cls}`;
      sp.textContent = state.prefs.style === 'pixel' ? uiTxt(text).toUpperCase() : text;
      return sp;
    }

    /* ==========================================================================
       6. DOM DIFFING ENGINE (card._d + textContent + insertBefore)
       ========================================================================== */
    function syncCard(container, d) {
      const mac = d.mac;
      const prof = resolveProfile(d);
      const offline = !d.online;
      const isNew = state.sessionNew.has(mac);
      const isPinned = state.prefs.pinned.includes(mac);
      const isSel = state.selected.has(mac);
      const grp = state.prefs.groups[mac] || '';
      const isPx = state.prefs.style === 'pixel';

      let rssiLvl = 0;
      if (d.band !== 'LAN' && typeof d.signal === 'number' && d.signal < 0) {
        rssiLvl = d.signal >= -55 ? 4 : d.signal >= -67 ? 3 : d.signal >= -78 ? 2 : 1;
      }

      let ref = domRegistry.get(mac);
      if (!ref) {
        const el = document.createElement('article');
        el.className = 'card';
        el.dataset.mac = mac;
        el.innerHTML = `
          <div class="card-top">
            <div class="profile">
              <div class="sel-chk">✓</div>
              <button type="button" class="icon-btn" title="Đổi biểu tượng">
                <span class="v-ico"></span>
                <span class="pin-mark">📌</span>
              </button>
              <div class="names">
                <div class="name-row">
                  <span class="name-main v-name"></span>
                  <button type="button" class="btn-edit-name" title="Đổi tên">✎</button>
                </div>
                <div class="name-sub">
                  <span class="v-sub"></span>
                  <span class="rssi v-rssi"><i></i><i></i><i></i><i></i></span>
                </div>
                <div class="tags v-tags"></div>
              </div>
            </div>
            <div class="switch-wrap">
              <label class="switch"><input type="checkbox" class="v-chk"><span class="track"></span></label>
              <span class="sw-lbl v-swlbl">CHẶN</span>
            </div>
          </div>
          <div class="matrix">
            <div class="m-col c-ip"><span class="m-k v-kip">IP / CỔNG</span><span class="m-v v-ip"></span></div>
            <div class="m-col c-mac"><span class="m-k">MAC</span><span class="m-v v-mac"></span></div>
            <svg class="spark-svg" viewBox="0 0 68 24" preserveAspectRatio="none"><polyline class="spark-line v-spark" points=""></polyline></svg>
          </div>
          <div class="card-bot">
            <div class="spd"><span class="spd-d">↓ <span class="v-rx"></span></span><span class="spd-u">↑ <span class="v-tx"></span></span></div>
            <div class="btns">
              <button type="button" class="btn-sm tonal b-qos">QoS</button>
              <button type="button" class="btn-sm b-static">Gán IP</button>
              <button type="button" class="btn-sm b-kick">Kick</button>
              <button type="button" class="btn-sm danger b-bl">Blacklist</button>
            </div>
          </div>
        `;

        ref = {
          el,
          ico: el.querySelector('.v-ico'),
          name: el.querySelector('.v-name'),
          sub: el.querySelector('.v-sub'),
          rssi: el.querySelector('.v-rssi'),
          tags: el.querySelector('.v-tags'),
          chk: el.querySelector('.v-chk'),
          swlbl: el.querySelector('.v-swlbl'),
          kip: el.querySelector('.v-kip'),
          ip: el.querySelector('.v-ip'),
          mac: el.querySelector('.v-mac'),
          spark: el.querySelector('.v-spark'),
          rx: el.querySelector('.v-rx'),
          tx: el.querySelector('.v-tx'),
          stat: el.querySelector('.b-static'),
          kick: el.querySelector('.b-kick'),
          bl: el.querySelector('.b-bl'),
          cache: {}
        };

        // Always read latest data from el._d
        el.querySelector('.icon-btn').onclick = e => {
          e.stopPropagation();
          vibrate();
          openIconPicker(el._d.mac, ref.cache.ico);
        };
        el.querySelector('.btn-edit-name').onclick = e => {
          e.stopPropagation();
          vibrate();
          openRename(el._d);
        };
        el.querySelector('.c-ip').onclick = e => {
          e.stopPropagation();
          if (el._d.ip) copyText(el._d.ip, 'IP');
        };
        el.querySelector('.c-mac').onclick = e => {
          e.stopPropagation();
          copyText(el._d.mac, 'MAC');
        };

        el.querySelector('.switch-wrap').onclick = e => e.stopPropagation();
        ref.chk.onchange = e => {
          vibrate();
          const cur = el._d;
          postAction({ action: e.target.checked ? 'block' : 'unblock', mac: cur.mac })
            .then(ok => { if (!ok) e.target.checked = !e.target.checked; else fetchList(); });
        };

        el.querySelector('.b-qos').onclick = e => {
          e.stopPropagation();
          vibrate();
          openQosModal(el._d);
        };
        ref.stat.onclick = e => {
          e.stopPropagation();
          const cur = el._d;
          if (!cur.ip) return;
          openConfirm('Cố định IP (Static DHCP)', `Khóa cứng IP ${cur.ip} cho "${resolveProfile(cur).name}"?`, () =>
            postAction({ action: 'static_lease', mac: cur.mac, ip: cur.ip })
          );
        };
        ref.kick.onclick = e => {
          e.stopPropagation();
          const cur = el._d;
          openConfirm('Kick khỏi Wi-Fi', `Ngắt kết nối ngay của "${resolveProfile(cur).name}"?`, () =>
            postAction({ action: 'kick', mac: cur.mac }).then(ok => ok && fetchList())
          );
        };
        ref.bl.onclick = e => {
          e.stopPropagation();
          const cur = el._d;
          const isBl = Boolean(cur.blacklisted);
          openConfirm(isBl ? 'Bỏ Blacklist' : 'Thêm Blacklist', `${isBl ? 'Cho phép' : 'Cấm vĩnh viễn'} "${resolveProfile(cur).name}"?`, () =>
            postAction({ action: isBl ? 'blacklist_remove' : 'blacklist_add', mac: cur.mac }).then(ok => ok && fetchList())
          );
        };

        let lpTimer = null, lpTriggered = false;
        el.addEventListener('pointerdown', e => {
          if (e.target.closest('button, label, input')) return;
          lpTriggered = false;
          lpTimer = setTimeout(() => { lpTriggered = true; enterSelectMode(el._d.mac); }, 480);
        });
        const cancelLp = () => { if (lpTimer) { clearTimeout(lpTimer); lpTimer = null; } };
        el.addEventListener('pointerup', cancelLp);
        el.addEventListener('pointerleave', cancelLp);
        el.addEventListener('pointercancel', cancelLp);

        el.onclick = () => {
          if (lpTriggered) return;
          if (state.selectMode) toggleSelect(el._d.mac);
          else { vibrate(12); openDetailSheet(el._d); }
        };

        domRegistry.set(mac, ref);
        container.appendChild(el);
      }

      ref.el._d = d;
      const c = ref.cache;

      if (c.offline !== offline) { ref.el.classList.toggle('offline', offline); c.offline = offline; }
      if (c.pinned !== isPinned) { ref.el.classList.toggle('pinned', isPinned); c.pinned = isPinned; }
      if (c.sel !== isSel) { ref.el.classList.toggle('selected', isSel); c.sel = isSel; }

      if (c.ico !== prof.icon) { ref.ico.textContent = prof.icon; c.ico = prof.icon; }
      if (c.name !== prof.name) { ref.name.textContent = prof.name; c.name = prof.name; }

      const statusTxt = d.online ? 'Online' : (fmtLastSeen(d.last_seen) || 'Offline');
      const subTxt = `${prof.vendor ? prof.vendor + ' - ' : ''}${statusTxt}`;
      if (c.subTxt !== subTxt) { ref.sub.textContent = subTxt; c.subTxt = subTxt; }

      if (c.rssiLvl !== rssiLvl) {
        if (rssiLvl > 0) {
          ref.rssi.style.display = 'inline-flex';
          ref.rssi.dataset.l = String(rssiLvl);
          ref.rssi.title = `${d.signal} dBm`;
        } else {
          ref.rssi.style.display = 'none';
        }
        c.rssiLvl = rssiLvl;
      }

      const qosTxt = fmtQos(Number(d.qos_rate || 0));
      const tagKey = `${isPx}|${isNew}|${prof.rand}|${d.band}|${grp}|${d.blocked}|${qosTxt}`;
      if (c.tagKey !== tagKey) {
        ref.tags.textContent = '';
        if (isNew) ref.tags.appendChild(createTag('Mới', 't-new'));
        if (prof.rand) ref.tags.appendChild(createTag('MAC riêng tư', 't-rand'));
        if (d.band) ref.tags.appendChild(createTag(d.band, 't-band'));
        if (grp) ref.tags.appendChild(createTag(grp, 't-grp'));
        if (qosTxt) ref.tags.appendChild(createTag(`Max ${qosTxt}`, 't-qos'));
        if (d.blocked) ref.tags.appendChild(createTag('Bị chặn', 't-blk'));
        c.tagKey = tagKey;
      }

      const blk = Boolean(d.blocked);
      if (c.blk !== blk) { ref.chk.checked = blk; c.blk = blk; }

      if (c.style !== state.prefs.style) {
        ref.swlbl.textContent = isPx ? 'CHAN' : 'CHẶN';
        ref.kip.textContent = isPx ? 'IP / CONG' : 'IP / CỔNG 📋';
        ref.stat.textContent = isPx ? 'GAN IP' : 'Gán IP';
        c.style = state.prefs.style;
      }

      const ipStr = `${d.ip || (isPx ? 'CHUA CAP IP' : 'Chưa cấp IP')} (${d.iface || 'eth'})`;
      if (c.ipStr !== ipStr) { ref.ip.textContent = ipStr; c.ipStr = ipStr; }
      if (c.mac !== mac) { ref.mac.textContent = mac; c.mac = mac; }

      const pts = buildSparkPoints(mac);
      if (c.pts !== pts) { ref.spark.setAttribute('points', pts); c.pts = pts; }

      const rxStr = fmtSpeed(d.rx);
      if (c.rxStr !== rxStr) { ref.rx.textContent = rxStr; c.rxStr = rxStr; }
      const txStr = fmtSpeed(d.tx);
      if (c.txStr !== txStr) { ref.tx.textContent = txStr; c.txStr = txStr; }

      const canStatic = Boolean(d.ip && !d.blacklisted);
      if (c.canStatic !== canStatic) { ref.stat.style.display = canStatic ? 'inline-block' : 'none'; c.canStatic = canStatic; }

      const canKick = Boolean(d.online && d.band !== 'LAN' && !d.blacklisted);
      if (c.canKick !== canKick) { ref.kick.style.display = canKick ? 'inline-block' : 'none'; c.canKick = canKick; }

      const isBl = Boolean(d.blacklisted);
      const blTxt = isPx ? (isBl ? 'BO BLACKLIST' : 'BLACKLIST') : (isBl ? 'Bỏ Blacklist' : 'Blacklist');
      if (c.blTxt !== blTxt) { ref.bl.textContent = blTxt; c.blTxt = blTxt; }
    }

    /* ==========================================================================
       7. MULTI-SELECT & RENDER PIPELINE
       ========================================================================== */
    function enterSelectMode(mac) {
      vibrate(35);
      state.selectMode = true;
      state.selected.clear();
      if (mac) state.selected.add(mac);
      document.body.classList.add('select-mode');
      updateBulkBar();
      render();
    }

    function exitSelectMode() {
      state.selectMode = false;
      state.selected.clear();
      document.body.classList.remove('select-mode');
      $('bulk-bar').classList.remove('show');
      render();
    }

    function toggleSelect(mac) {
      vibrate(12);
      if (state.selected.has(mac)) state.selected.delete(mac);
      else state.selected.add(mac);
      if (state.selected.size === 0) exitSelectMode();
      else { updateBulkBar(); render(); }
    }

    function updateBulkBar() {
      const bar = $('bulk-bar');
      if (state.selectMode && state.selected.size > 0) {
        bar.classList.add('show');
        $('bulk-cnt').textContent = state.prefs.style === 'pixel'
          ? `DA CHON ${state.selected.size}`
          : `Đã chọn ${state.selected.size}`;
      } else {
        bar.classList.remove('show');
      }
    }

    async function runBulkAction(action) {
      const macs = [...state.selected];
      if (!macs.length) return;
      exitSelectMode();
      toast(`Đang gửi lệnh ${action} cho ${macs.length} thiết bị...`);
      for (const mac of macs) {
        const dev = state.devices.find(x => x.mac === mac);
        if (!dev) continue;
        if (action === 'kick' && (!dev.online || dev.band === 'LAN')) continue;
        await postAction({ action, mac }, true);
      }
      toast('Hoàn tất thao tác hàng loạt');
      fetchList();
    }

    function renderGroupChips() {
      const wrap = $('group-chips');
      const allGroups = [...new Set([...DEFAULT_GROUPS, ...state.prefs.customGroups])];
      wrap.textContent = '';
      allGroups.forEach(g => {
        const c = document.createElement('div');
        c.className = `chip ${state.groupFilter === g ? 'active' : ''}`;
        c.textContent = state.prefs.style === 'pixel' ? uiTxt(g).toUpperCase() : g;
        c.onclick = () => {
          vibrate();
          state.groupFilter = state.groupFilter === g ? '' : g;
          renderGroupChips();
          render();
        };
        wrap.appendChild(c);
      });
    }

    function renderSysPanel() {
      const panel = $('sys-panel');
      if (!state.sys || typeof state.sys !== 'object') {
        panel.style.display = 'none';
        return;
      }
      panel.style.display = 'block';
      const s = state.sys;
      const load = typeof s.load === 'number' ? s.load : null;
      const mem = typeof s.mem_used_pct === 'number' ? s.mem_used_pct : null;
      $('sys-load').textContent = load !== null ? load.toFixed(2) : '-';
      $('seg-cpu').style.width = load !== null ? `${Math.min(100, Math.round(load * 25))}%` : '0%';
      $('sys-mem').textContent = mem !== null ? `${mem}%` : '-';
      $('seg-ram').style.width = mem !== null ? `${Math.min(100, mem)}%` : '0%';
      $('sys-up').textContent = fmtUptime(s.uptime);
      $('sys-cli').textContent = typeof s.clients === 'number' ? String(s.clients) : '-';
    }

    function renderTop3(clients) {
      const row = $('top3-row');
      const listEl = $('top3-list');
      const active = clients
        .filter(d => d.online && ((d.rx || 0) + (d.tx || 0)) > 0)
        .sort((a, b) => ((b.rx || 0) + (b.tx || 0)) - ((a.rx || 0) + (a.tx || 0)))
        .slice(0, 3);

      if (!active.length) {
        row.style.display = 'none';
        return;
      }
      row.style.display = 'flex';
      listEl.textContent = '';
      active.forEach(d => {
        const p = resolveProfile(d);
        const pill = document.createElement('div');
        pill.className = 'top3-pill';
        const b = document.createElement('b');
        b.textContent = p.name;
        const sp = document.createElement('span');
        sp.textContent = fmtSpeed((d.rx || 0) + (d.tx || 0));
        if (state.prefs.style === 'pixel') {
          pill.append(b, document.createTextNode(' '), sp);
        } else {
          pill.append(document.createTextNode(p.icon + ' '), b, sp);
        }
        pill.onclick = () => openDetailSheet(d);
        listEl.appendChild(pill);
      });
    }

    function render() {
      renderSysPanel();
      const container = $('list');

      let list = state.devices.filter(d =>
        state.tab === 'blacklist' ? Boolean(d.blacklisted) : (!d.blacklisted && (d.online || d.blocked))
      );

      if (state.filter === '5g') list = list.filter(d => (d.band || '').includes('5G'));
      else if (state.filter === '2g') list = list.filter(d => (d.band || '').includes('2'));
      else if (state.filter === 'lan') list = list.filter(d => d.band === 'LAN');
      else if (state.filter === 'blocked') list = list.filter(d => d.blocked);
      else if (state.filter === 'weak') list = list.filter(d => d.online && d.band !== 'LAN' && d.signal && d.signal < -72);

      if (state.groupFilter) {
        list = list.filter(d => (state.prefs.groups[d.mac] || '') === state.groupFilter);
      }

      if (state.query) {
        const q = state.query;
        list = list.filter(d => {
          const p = resolveProfile(d);
          const g = (state.prefs.groups[d.mac] || '').toLowerCase();
          return d.mac.toLowerCase().includes(q) || (d.ip && d.ip.includes(q)) ||
                 p.name.toLowerCase().includes(q) || p.vendor.toLowerCase().includes(q) || g.includes(q);
        });
      }

      const pinSet = new Set(state.prefs.pinned);
      list.sort((a, b) => {
        const pa = pinSet.has(a.mac) ? 1 : 0;
        const pb = pinSet.has(b.mac) ? 1 : 0;
        if (pa !== pb) return pb - pa;

        if (state.sort === 'speed') return ((b.rx || 0) + (b.tx || 0)) - ((a.rx || 0) + (a.tx || 0));
        if (state.sort === 'name') return resolveProfile(a).name.localeCompare(resolveProfile(b).name, 'vi');
        if (state.sort === 'newest') {
          const na = state.sessionNew.has(a.mac) ? 1 : 0;
          const nb = state.sessionNew.has(b.mac) ? 1 : 0;
          if (na !== nb) return nb - na;
          return (state.firstOrder.get(b.mac) || 0) - (state.firstOrder.get(a.mac) || 0);
        }
        return (state.firstOrder.get(a.mac) || 0) - (state.firstOrder.get(b.mac) || 0);
      });

      const activeSet = new Set(list.map(d => d.mac));
      for (const [mac, ref] of domRegistry.entries()) {
        if (!activeSet.has(mac)) {
          ref.el.remove();
          domRegistry.delete(mac);
        }
      }

      list.forEach((d, idx) => {
        syncCard(container, d);
        const ref = domRegistry.get(d.mac);
        if (ref && container.children[idx] !== ref.el) {
          container.insertBefore(ref.el, container.children[idx] || null);
        }
      });

      $('empty').style.display = list.length === 0 ? 'block' : 'none';

      const clients = state.devices.filter(d => !d.blacklisted && (d.online || d.blocked));
      let onlineCnt = 0, rxSum = 0, txSum = 0;
      for (const c of clients) {
        if (c.online) {
          onlineCnt++;
          rxSum += (c.rx || 0);
          txSum += (c.tx || 0);
        }
      }
      $('cnt-cli').textContent = clients.length;
      $('cnt-blk').textContent = state.devices.filter(d => d.blacklisted).length;
      $('tot-cnt').textContent = `${onlineCnt} / ${clients.length}`;
      $('tot-rx').textContent = fmtSpeed(rxSum);
      $('tot-tx').textContent = fmtSpeed(txSum);
      renderTop3(clients);
    }

    /* ==========================================================================
       8. API COMMUNICATION & POLLING
       ========================================================================== */
    async function postAction(payload, silent = false) {
      if (state.writing) {
        if (!silent) toast('Đang gửi lệnh khác, vui lòng đợi...');
        return false;
      }
      state.writing = true;
      const ctrl = new AbortController();
      const tid = setTimeout(() => ctrl.abort(), 4000);

      try {
        if (DEMO_MODE) {
          await new Promise(r => setTimeout(r, 200));
          if (payload.action === 'reboot') {
            clearTimeout(tid); if (!silent) toast('Đã gửi lệnh khởi động lại'); return true;
          }
          const dev = state.devices.find(x => x.mac === payload.mac);
          if (dev) {
            if (payload.action === 'block') dev.blocked = true;
            if (payload.action === 'unblock') dev.blocked = false;
            if (payload.action === 'rename') dev.name = payload.name;
            if (payload.action === 'qos_limit') dev.qos_rate = payload.rate;
            if (payload.action === 'blacklist_add') dev.blacklisted = true;
            if (payload.action === 'blacklist_remove') dev.blacklisted = false;
            if (payload.action === 'kick') dev.online = false;
          } else if (payload.action === 'blacklist_add') {
            state.devices.push({ mac: payload.mac, ip: '', hostname: '', name: '', vendor: '', iface: 'phy1-ap0', band: '5G', signal: 0, rx: 0, tx: 0, qos_rate: 0, online: false, blocked: false, blacklisted: true });
          }
          clearTimeout(tid);
          if (!silent) { vibrate(); toast('Thành công'); }
          render();
          return true;
        }

        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          signal: ctrl.signal
        });
        clearTimeout(tid);
        const data = await res.json();
        if (data && data.ok) {
          if (!silent) { vibrate(); toast('Thành công'); }
          return true;
        }
        if (!silent) toast((data && data.error) || 'Router từ chối thao tác');
        return false;
      } catch (e) {
        clearTimeout(tid);
        if (!silent) toast(e.name === 'AbortError' ? 'Quá thời gian (4s)' : 'Lỗi kết nối Router');
        return false;
      } finally {
        state.writing = false;
      }
    }

    function processIncomingDevices(devices) {
      if (state.known === null) {
        const stored = localStorage.getItem(KNOWN_KEY);
        if (stored === null) {
          state.known = new Set(devices.map(d => d.mac));
          localStorage.setItem(KNOWN_KEY, JSON.stringify([...state.known]));
        } else {
          try { state.known = new Set(JSON.parse(stored)); } catch (e) { state.known = new Set(); }
        }
      }

      let knownChanged = false;
      devices.forEach(d => {
        if (!d.mac) return;
        if (!state.firstOrder.has(d.mac)) {
          state.firstOrder.set(d.mac, state.firstOrder.size);
        }
        if (!state.known.has(d.mac)) {
          state.sessionNew.add(d.mac);
          state.known.add(d.mac);
          knownChanged = true;
        }
        const hist = speedHistory.get(d.mac) || [];
        hist.push(d.online ? ((d.rx || 0) + (d.tx || 0)) : 0);
        if (hist.length > 30) hist.shift();
        speedHistory.set(d.mac, hist);
      });

      if (knownChanged) {
        localStorage.setItem(KNOWN_KEY, JSON.stringify([...state.known]));
      }
    }

    function scheduleNextPoll() {
      if (state.timer) { clearTimeout(state.timer); state.timer = null; }
      if (state.isIdle || document.visibilityState !== 'visible') return;
      if (state.prefs.pollMs === 0 && state.errors === 0) return;
      const wait = state.errors > 0 ? state.backoff : state.prefs.pollMs;
      if (wait > 0) state.timer = setTimeout(fetchList, wait);
    }

    async function fetchList() {
      if (state.isIdle) return;
      if (state.timer) { clearTimeout(state.timer); state.timer = null; }
      const dot = $('sync-dot');
      const walker = $('px-walker');
      dot.className = 'sync-dot syncing';
      walker.className = 'px-walker syncing';

      if (DEMO_MODE) {
        if (!state.devices.length) {
          const now = Math.floor(Date.now() / 1000);
          state.sys = { load: 0.35, mem_used_pct: 41, uptime: 174200, clients: 4 };
          state.devices = [
            { mac: 'F0:99:BF:11:22:33', ip: '192.168.2.10', hostname: 'iPhone-Pro', name: '', vendor: 'Apple', iface: 'phy1-ap0', band: '5G', signal: -48, rx: 1450000, tx: 230000, qos_rate: 0, online: true, blocked: false, blacklisted: false, day_rx: 2450000000, day_tx: 320000000 },
            { mac: 'B4:FB:E4:44:55:66', ip: '192.168.2.15', hostname: 'Mi-TV', name: 'TV Phòng Khách', vendor: 'Xiaomi', iface: 'phy1-ap0', band: '5G', signal: -63, rx: 3850000, tx: 92000, qos_rate: 5120, online: true, blocked: false, blacklisted: false, day_rx: 8920000000, day_tx: 110000000 },
            { mac: 'D8:3A:DD:77:88:99', ip: '192.168.2.20', hostname: 'raspberrypi', name: '', vendor: 'Raspberry Pi', iface: 'eth0.1', band: 'LAN', signal: 0, rx: 64000, tx: 21000, qos_rate: 0, online: true, blocked: false, blacklisted: false, day_rx: 512000000, day_tx: 480000000 },
            { mac: '3E:A1:90:AA:BB:CC', ip: '192.168.2.35', hostname: 'android-8f92a1bc', name: '', vendor: 'ShouldIgnore', iface: 'phy0-ap0', band: '2.4G', signal: -79, rx: 0, tx: 0, qos_rate: 0, online: false, blocked: true, blacklisted: false, last_seen: now - 7200, day_rx: 120000000, day_tx: 15000000 }
          ];
        } else {
          state.devices.forEach(d => {
            if (d.online) {
              d.rx = Math.max(0, Math.round(d.rx * (0.75 + Math.random() * 0.5)));
              d.tx = Math.max(0, Math.round(d.tx * (0.75 + Math.random() * 0.5)));
            }
          });
        }
        processIncomingDevices(state.devices);
        dot.className = 'sync-dot';
        walker.className = 'px-walker';
        $('err-banner').style.display = 'none';
        render();
        scheduleNextPoll();
        return;
      }

      const ctrl = new AbortController();
      const tid = setTimeout(() => ctrl.abort(), 4000);

      try {
        const res = await fetch(`${API}?action=list`, { signal: ctrl.signal, cache: 'no-store' });
        clearTimeout(tid);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const json = await res.json();
        state.sys = json.sys || null;
        state.devices = Array.isArray(json.devices) ? json.devices : [];
        processIncomingDevices(state.devices);

        state.errors = 0;
        state.backoff = 5000;
        dot.className = 'sync-dot';
        walker.className = 'px-walker';
        $('err-banner').style.display = 'none';
        render();
      } catch (e) {
        clearTimeout(tid);
        state.errors++;
        state.backoff = state.errors === 1 ? 5000 : state.errors === 2 ? 10000 : 30000;
        dot.className = 'sync-dot err';
        walker.className = 'px-walker err';
        $('err-banner').style.display = 'flex';
      } finally {
        scheduleNextPoll();
      }
    }

    /* ==========================================================================
       9. DIALOGS & BOTTOM SHEET (WOL REMOVED)
       ========================================================================== */
    let dlgCb = null;

    function openModal({ title, desc, sheet = false, okText = 'Xác nhận', okClass = 'danger', showOk = true, buildBody, onOk }) {
      const isPx = state.prefs.style === 'pixel';
      const scrim = $('dlg-scrim');
      scrim.classList.toggle('sheet-mode', sheet && !isPx);
      $('sheet-handle').style.display = (sheet && !isPx) ? 'block' : 'none';
      $('dlg-title').textContent = isPx ? uiTxt(title).toUpperCase() : title;
      $('dlg-desc').textContent = isPx ? uiTxt(desc || '') : (desc || '');

      const body = $('dlg-body');
      body.textContent = '';
      if (buildBody) {
        body.style.display = 'block';
        buildBody(body);
      } else {
        body.style.display = 'none';
      }

      const okBtn = $('dlg-ok');
      okBtn.style.display = showOk ? 'inline-block' : 'none';
      okBtn.textContent = isPx ? uiTxt(okText).toUpperCase() : okText;
      okBtn.className = `btn-sm ${okClass}`;
      dlgCb = onOk || null;

      scrim.classList.remove('hidden');
    }

    function closeDlg() {
      $('dlg-scrim').classList.add('hidden');
      $('dlg-body').textContent = '';
      dlgCb = null;
    }

    $('dlg-cancel').onclick = closeDlg;
    $('dlg-scrim').onclick = e => { if (e.target === $('dlg-scrim')) closeDlg(); };
    $('dlg-ok').onclick = () => {
      const cb = dlgCb;
      closeDlg();
      if (cb) cb();
    };

    function openConfirm(title, desc, cb) {
      openModal({ title, desc, okText: 'Xác nhận', okClass: 'danger', onOk: cb });
    }

    function openDetailSheet(d) {
      const isPx = state.prefs.style === 'pixel';
      const prof = resolveProfile(d);
      const isPinned = state.prefs.pinned.includes(d.mac);
      const curGrp = state.prefs.groups[d.mac] || '';
      const allGroups = [...new Set([...DEFAULT_GROUPS, ...state.prefs.customGroups])];

      openModal({
        title: isPx ? prof.name : `${prof.icon} ${prof.name}`,
        desc: `${d.mac} - ${d.online ? (isPx ? 'DANG KET NOI' : 'Đang kết nối') : (fmtLastSeen(d.last_seen) || 'Offline')}`,
        sheet: true,
        showOk: false,
        buildBody: body => {
          const grid = document.createElement('div');
          grid.className = 'detail-grid';
          const items = [
            [isPx ? 'DIA CHI IP' : 'Địa chỉ IP', d.ip || (isPx ? 'CHUA CAP' : 'Chưa cấp')],
            [isPx ? 'CONG / BANG TAN' : 'Interface / Băng tần', `${d.iface || '-'} (${d.band || '-'})`],
            [isPx ? 'NHA SAN XUAT' : 'Nhà sản xuất', prof.rand ? (isPx ? 'MAC RIENG TU' : 'MAC riêng tư') : (prof.vendor || (isPx ? 'KHONG RO' : 'Không rõ'))],
            [isPx ? 'TIN HIEU WI-FI' : 'Tín hiệu Wi-Fi', d.band === 'LAN' ? 'LAN' : (d.signal ? `${d.signal} dBm` : '-')],
            [isPx ? 'TOC DO HIEN TAI' : 'Tốc độ hiện tại', `↓ ${fmtSpeed(d.rx)} / ↑ ${fmtSpeed(d.tx)}`]
          ];
          if (typeof d.day_rx === 'number' || typeof d.day_tx === 'number') {
            items.push([isPx ? 'LUU LUONG HOM NAY' : 'Lưu lượng hôm nay', `↓ ${fmtBytes(d.day_rx)} / ↑ ${fmtBytes(d.day_tx)}`]);
          }
          items.forEach(([k, v]) => {
            const box = document.createElement('div');
            box.className = 'd-item';
            const kl = document.createElement('span'); kl.className = 'd-k'; kl.textContent = k;
            const vl = document.createElement('span'); vl.className = 'd-v'; vl.textContent = v;
            box.append(kl, vl);
            grid.appendChild(box);
          });
          body.appendChild(grid);

          const gLbl = document.createElement('label');
          gLbl.className = 'field-lbl';
          gLbl.textContent = isPx ? 'NHOM THIET BI' : 'Nhóm thiết bị (Lưu trên máy)';
          const gSel = document.createElement('select');
          gSel.className = 'input-m3';
          const optNone = document.createElement('option'); optNone.value = '';
          optNone.textContent = isPx ? '-- KHONG PHAN NHOM --' : '-- Không phân nhóm --';
          gSel.appendChild(optNone);
          allGroups.forEach(g => {
            const o = document.createElement('option'); o.value = g;
            o.textContent = isPx ? uiTxt(g).toUpperCase() : g;
            if (g === curGrp) o.selected = true;
            gSel.appendChild(o);
          });
          const optNew = document.createElement('option'); optNew.value = '__new__';
          optNew.textContent = isPx ? '+ TAO NHOM MOI...' : '+ Tạo nhóm mới...';
          gSel.appendChild(optNew);

          gSel.onchange = () => {
            if (gSel.value === '__new__') {
              const name = prompt(isPx ? 'Nhap ten nhom moi:' : 'Nhập tên nhóm mới:');
              if (name && name.trim()) {
                const clean = name.trim().slice(0, 20);
                if (!state.prefs.customGroups.includes(clean)) state.prefs.customGroups.push(clean);
                state.prefs.groups[d.mac] = clean;
                savePrefs(); renderGroupChips(); render(); closeDlg();
              } else {
                gSel.value = curGrp;
              }
            } else {
              if (gSel.value) state.prefs.groups[d.mac] = gSel.value;
              else delete state.prefs.groups[d.mac];
              savePrefs(); render(); toast('Đã cập nhật nhóm');
            }
          };
          body.append(gLbl, gSel);

          const actGrid = document.createElement('div');
          actGrid.className = 'sheet-actions';

          const mkBtn = (txt, cls, fn) => {
            const b = document.createElement('button');
            b.type = 'button'; b.className = `sheet-btn ${cls}`;
            b.textContent = isPx ? uiTxt(txt).toUpperCase() : txt;
            b.onclick = () => { closeDlg(); fn(); };
            actGrid.appendChild(b);
          };

          mkBtn(isPinned ? '📌 Bỏ ghim đầu trang' : '📌 Ghim lên đầu', 'primary', () => {
            if (isPinned) state.prefs.pinned = state.prefs.pinned.filter(x => x !== d.mac);
            else state.prefs.pinned.unshift(d.mac);
            savePrefs(); render(); toast(isPinned ? 'Đã bỏ ghim' : 'Đã ghim lên đầu');
          });
          mkBtn('✎ Đổi tên', '', () => openRename(d));
          mkBtn('⏱ Giới hạn QoS', '', () => openQosModal(d));
          if (d.ip) mkBtn('🔒 Gán IP cố định', '', () => postAction({ action: 'static_lease', mac: d.mac, ip: d.ip }));
          if (d.online && d.band !== 'LAN') mkBtn('👢 Kick Wi-Fi', 'danger', () => postAction({ action: 'kick', mac: d.mac }).then(ok => ok && fetchList()));
          body.appendChild(actGrid);
        }
      });
    }

    function openRename(d) {
      const prof = resolveProfile(d);
      openModal({
        title: 'Đổi tên thiết bị',
        desc: `Lưu tên trên Router cho [${d.mac}] (để trống để xóa tên tự đặt):`,
        okText: 'Lưu tên',
        okClass: 'tonal',
        buildBody: body => {
          const inp = document.createElement('input');
          inp.className = 'input-m3'; inp.maxLength = 32; inp.id = 'inp-rename';
          inp.value = (d.name || '').trim();
          inp.placeholder = prof.name;
          body.appendChild(inp);
          setTimeout(() => inp.focus(), 50);
        },
        onOk: () => {
          const val = $('inp-rename').value.trim();
          if (val !== (d.name || '').trim()) {
            postAction({ action: 'rename', mac: d.mac, name: val }).then(ok => ok && fetchList());
          }
        }
      });
    }

    function openQosModal(d) {
      const curRate = Number(d.qos_rate || 0);
      openModal({
        title: 'Giới hạn băng thông (QoS)',
        desc: `Đặt tốc độ tối đa (KB/s) cho "${resolveProfile(d).name}". Nhập 0 để gỡ, tối thiểu 16 KB/s:`,
        okText: 'Áp dụng',
        okClass: 'tonal',
        buildBody: body => {
          const inp = document.createElement('input');
          inp.type = 'number'; inp.min = '0'; inp.step = '16'; inp.className = 'input-m3'; inp.id = 'inp-qos';
          inp.value = curRate;
          const pRow = document.createElement('div');
          pRow.style.cssText = 'display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px';
          [[0,'Gỡ (0)'],[512,'512 KB/s'],[1024,'1 MB/s'],[3072,'3 MB/s'],[5120,'5 MB/s']].forEach(([v, l]) => {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'btn-sm tonal';
            b.textContent = state.prefs.style === 'pixel' ? uiTxt(l).toUpperCase() : l;
            b.onclick = () => { inp.value = v; };
            pRow.appendChild(b);
          });
          body.append(pRow, inp);
        },
        onOk: () => {
          const raw = parseInt($('inp-qos').value || '0', 10);
          const rate = raw <= 0 ? 0 : Math.max(16, raw);
          if (rate !== curRate) {
            postAction({ action: 'qos_limit', mac: d.mac, rate }).then(ok => ok && fetchList());
          }
        }
      });
    }

    function openIconPicker(mac, cur) {
      let chosen = cur;
      openModal({
        title: 'Chọn biểu tượng',
        desc: `Biểu tượng hiển thị cho [${mac}]:`,
        okText: 'Lưu',
        okClass: 'tonal',
        buildBody: body => {
          const g = document.createElement('div');
          g.className = 'icon-grid';
          ICONS.forEach(ic => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = `icon-opt ${ic === cur ? 'sel' : ''}`;
            b.textContent = ic;
            b.onclick = () => {
              g.querySelectorAll('.icon-opt').forEach(x => x.classList.remove('sel'));
              b.classList.add('sel');
              chosen = ic;
            };
            g.appendChild(b);
          });
          body.appendChild(g);
        },
        onOk: () => {
          state.prefs.icons[mac] = chosen;
          savePrefs();
          render();
          toast(`Đã đổi biểu tượng ${chosen}`);
        }
      });
    }

    function openAddMac() {
      openModal({
        title: 'Thêm vào Blacklist',
        desc: 'Nhập địa chỉ MAC cần cấm kết nối vĩnh viễn:',
        okText: 'Chặn MAC',
        okClass: 'danger',
        buildBody: body => {
          const inp = document.createElement('input');
          inp.className = 'input-m3'; inp.maxLength = 17; inp.id = 'inp-mac';
          inp.placeholder = 'AA:BB:CC:DD:EE:FF';
          body.appendChild(inp);
          setTimeout(() => inp.focus(), 50);
        },
        onOk: () => {
          const mac = $('inp-mac').value.trim().toUpperCase();
          if (/^([0-9A-F]{2}[:-]){5}([0-9A-F]{2})$/.test(mac)) {
            postAction({ action: 'blacklist_add', mac }).then(ok => ok && fetchList());
          } else {
            toast('Địa chỉ MAC không hợp lệ');
          }
        }
      });
    }

    function openSettingsModal() {
      const isPx = state.prefs.style === 'pixel';
      openModal({
        title: 'Cài đặt & Quản trị Router',
        desc: 'Sao lưu cấu hình giao diện ra JSON hoặc khởi động lại CR6608:',
        showOk: false,
        buildBody: body => {
          const expBtn = document.createElement('button');
          expBtn.type = 'button'; expBtn.className = 'sheet-btn primary'; expBtn.style.width = '100%'; expBtn.style.marginBottom = '8px';
          expBtn.textContent = isPx ? 'XUAT CAI DAT (.JSON)' : '📤 Xuất toàn bộ cài đặt (.json)';
          expBtn.onclick = () => {
            const blob = new Blob([JSON.stringify(state.prefs, null, 2)], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `cr6608-settings-${new Date().toISOString().slice(0,10)}.json`;
            a.click();
            URL.revokeObjectURL(a.href);
            toast('Đã tải xuống file cấu hình JSON');
          };

          const impInp = document.createElement('input');
          impInp.type = 'file'; impInp.accept = '.json,application/json'; impInp.style.display = 'none';
          impInp.onchange = e => {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = () => {
              try {
                const parsed = JSON.parse(String(reader.result));
                if (typeof parsed !== 'object' || !parsed) throw new Error();
                state.prefs = { ...defaultPrefs, ...parsed };
                savePrefs();
                applyAppearance();
                closeDlg();
                toast('Đã khôi phục toàn bộ cài đặt');
              } catch (err) {
                toast('File JSON không hợp lệ');
              }
            };
            reader.readAsText(file);
          };

          const impBtn = document.createElement('button');
          impBtn.type = 'button'; impBtn.className = 'sheet-btn'; impBtn.style.width = '100%'; impBtn.style.marginBottom = '14px';
          impBtn.textContent = isPx ? 'NHAP CAI DAT TU JSON' : '📥 Nhập cài đặt từ file JSON';
          impBtn.onclick = () => impInp.click();

          const rebBtn = document.createElement('button');
          rebBtn.type = 'button'; rebBtn.className = 'sheet-btn danger'; rebBtn.style.width = '100%';
          rebBtn.textContent = isPx ? 'KHOI DONG LAI ROUTER CR6608' : '🔄 Khởi động lại Router CR6608';
          rebBtn.onclick = () => {
            openConfirm('Xác nhận bước 1/2', 'Router sẽ ngắt toàn bộ Wi-Fi và mạng trong khoảng 1 phút. Tiếp tục?', () => {
              setTimeout(() => {
                openConfirm('Xác nhận cuối cùng (2/2)', 'Bạn chắc chắn muốn KHỞI ĐỘNG LẠI router ngay bây giờ?', () => {
                  postAction({ action: 'reboot' });
                });
              }, 120);
            });
          };

          body.append(expBtn, impInp, impBtn, rebBtn);
        }
      });
    }

    /* ==========================================================================
       10. 30S INACTIVITY AUTO-CLOSE / SLEEP
       ========================================================================== */
    function enterIdleState() {
      if (state.isIdle) return;
      state.isIdle = true;
      if (state.timer) { clearTimeout(state.timer); state.timer = null; }
      closeDlg();
      if (state.selectMode) exitSelectMode();
      $('idle-screen').hidden = false;
      try { window.close(); } catch (e) {}
    }

    function resetIdleTimer() {
      if (state.isIdle) return;
      if (state.idleTimer) clearTimeout(state.idleTimer);
      state.idleTimer = setTimeout(enterIdleState, IDLE_TIMEOUT_MS);
    }

    function wakeFromIdle() {
      vibrate();
      state.isIdle = false;
      $('idle-screen').hidden = true;
      resetIdleTimer();
      fetchList();
    }

    /* ==========================================================================
       11. INITIALIZATION & EVENT LISTENERS
       ========================================================================== */
    (function init() {
      applyAppearance();
      typePixelSubtitle();

      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (state.prefs.theme === 'auto') applyAppearance();
      });

      // Style cycle: pixel -> m3 -> glass
      $('btn-style').onclick = () => {
        vibrate();
        const order = ['pixel', 'm3', 'glass'];
        state.prefs.style = order[(order.indexOf(state.prefs.style) + 1) % order.length];
        savePrefs();
        applyAppearance();
        typePixelSubtitle();
      };

      // Theme cycle: auto -> dark -> light
      $('btn-theme').onclick = () => {
        vibrate();
        const order = ['auto', 'dark', 'light'];
        state.prefs.theme = order[(order.indexOf(state.prefs.theme) + 1) % order.length];
        savePrefs();
        applyAppearance();
      };

      // Poll interval cycle: 5s -> 10s -> 30s -> manual
      $('btn-poll').onclick = () => {
        vibrate();
        const cycle = [5000, 10000, 30000, 0];
        const next = cycle[(cycle.indexOf(state.prefs.pollMs) + 1) % cycle.length];
        state.prefs.pollMs = next;
        savePrefs();
        applyAppearance();
        scheduleNextPoll();
        toast(next === 0 ? 'Chế độ làm mới thủ công' : `Tự làm mới mỗi ${next / 1000} giây`);
      };

      $('btn-settings').onclick = () => { vibrate(); openSettingsModal(); };
      $('btn-refresh').onclick = () => { vibrate(); toast('Đang cập nhật...'); fetchList(); };
      $('btn-retry').onclick = fetchList;
      $('fab-add').onclick = () => { vibrate(); openAddMac(); };

      $('btn-wake').onclick = wakeFromIdle;
      ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(evt => {
        document.addEventListener(evt, resetIdleTimer, { passive: true });
      });
      resetIdleTimer();

      $('sys-toggle').onclick = () => {
        const p = $('sys-panel');
        p.classList.toggle('collapsed');
        const isCol = p.classList.contains('collapsed');
        const lbl = isCol ? 'Chi tiết ▾' : 'Thu gọn ▴';
        $('sys-summary').textContent = state.prefs.style === 'pixel' ? uiTxt(lbl).toUpperCase() : lbl;
      };

      $('bulk-block').onclick = () => runBulkAction('block');
      $('bulk-unblock').onclick = () => runBulkAction('unblock');
      $('bulk-kick').onclick = () => runBulkAction('kick');
      $('bulk-exit').onclick = exitSelectMode;

      let sTimer = null;
      $('search').oninput = e => {
        clearTimeout(sTimer);
        sTimer = setTimeout(() => {
          state.query = e.target.value.trim().toLowerCase();
          render();
        }, 120);
      };

      $('filter-chips').onclick = e => {
        const c = e.target.closest('.chip[data-f]');
        if (!c) return;
        vibrate();
        $('filter-chips').querySelectorAll('.chip[data-f]').forEach(x => x.classList.remove('active'));
        c.classList.add('active');
        state.filter = c.dataset.f;
        render();
      };

      $('sort-chips').onclick = e => {
        const c = e.target.closest('.chip[data-s]');
        if (!c) return;
        vibrate();
        $('sort-chips').querySelectorAll('.chip[data-s]').forEach(x => x.classList.remove('active'));
        c.classList.add('active');
        state.sort = c.dataset.s;
        render();
      };

      $('tab-clients').onclick = () => {
        if (state.tab === 'clients') return;
        vibrate(); state.tab = 'clients';
        $('tab-clients').classList.add('active'); $('tab-blacklist').classList.remove('active');
        render();
      };
      $('tab-blacklist').onclick = () => {
        if (state.tab === 'blacklist') return;
        vibrate(); state.tab = 'blacklist';
        $('tab-blacklist').classList.add('active'); $('tab-clients').classList.remove('active');
        render();
      };

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          if (!state.isIdle) { resetIdleTimer(); fetchList(); }
        } else {
          if (state.timer) { clearTimeout(state.timer); state.timer = null; }
        }
      });

      fetchList();
    })();
  </script>
</body>
</html>
