<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0B0C0B" id="meta-theme">
  <title>CR6608 Device Manager</title>
  <style>
    /* ==========================================================================
       1. FONT & RESET
       ========================================================================== */
    @font-face {
      font-family: "Pixel5x7";
      src: url('/pixel-5x7.woff2') format('woff2');
      font-weight: normal;
      font-style: normal;
      font-display: swap;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      --font-px: "Pixel5x7", ui-monospace, monospace;

      --r-xs: 6px; --r-sm: 10px; --r-md: 14px; --r-lg: 20px; --r-xl: 28px; --r-full: 9999px;

      /* Material 3 Light */
      --primary: #0061A4; --on-primary: #FFFFFF;
      --primary-container: #D1E4FF; --on-primary-container: #001D36;
      --secondary-container: #D7E3F7; --on-secondary-container: #101C2B;
      --tertiary-container: #F2DAFF; --on-tertiary-container: #251431;
      --error: #BA1A1A; --on-error: #FFFFFF;
      --error-container: #FFDAD6; --on-error-container: #410002;
      --warning-container: #FFDEA6; --on-warning-container: #271900;
      --bg: #F8F9FF; --on-bg: #191C20;
      --on-surface-variant: #43474E;
      --outline: #73777F; --outline-variant: #C3C7D0;
      --surf-lowest: #FFFFFF; --surf-low: #F2F3FA; --surf: #ECEEF4; --surf-high: #E6E8EE; --surf-highest: #E0E2E8;
      --success: #198754;
      --card-shadow: none;
      --glass-blur: none;
    }

    [data-theme="dark"] {
      /* Material 3 Dark */
      --primary: #9ECAFF; --on-primary: #003258;
      --primary-container: #00497D; --on-primary-container: #D1E4FF;
      --secondary-container: #3B4858; --on-secondary-container: #D7E3F7;
      --tertiary-container: #523F5F; --on-tertiary-container: #F2DAFF;
      --error: #FFB4AB; --on-error: #690005;
      --error-container: #93000A; --on-error-container: #FFDAD6;
      --warning-container: #5B4300; --on-warning-container: #FFDEA6;
      --bg: #111318; --on-bg: #E2E2E9;
      --on-surface-variant: #C3C7D0;
      --outline: #8D9199; --outline-variant: #43474E;
      --surf-lowest: #0C0E13; --surf-low: #191C20; --surf: #1D2024; --surf-high: #282A2F; --surf-highest: #33353A;
      --success: #75B798;
    }

    /* iOS Liquid Glass Light */
    [data-style="glass"] {
      --bg: linear-gradient(145deg, #E4EEFF 0%, #F4F0FF 48%, #E6F7FF 100%);
      --surf-lowest: rgba(255, 255, 255, 0.55);
      --surf-low: rgba(255, 255, 255, 0.68);
      --surf: rgba(255, 255, 255, 0.78);
      --surf-high: rgba(255, 255, 255, 0.88);
      --surf-highest: rgba(240, 244, 255, 0.95);
      --outline-variant: rgba(255, 255, 255, 0.85);
      --card-shadow: 0 6px 20px rgba(15, 35, 80, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.9);
      --glass-blur: blur(14px);
    }

    /* iOS Liquid Glass Dark */
    [data-style="glass"][data-theme="dark"] {
      --bg: linear-gradient(145deg, #0B1221 0%, #161229 50%, #0C1B24 100%);
      --surf-lowest: rgba(22, 27, 40, 0.55);
      --surf-low: rgba(28, 34, 50, 0.65);
      --surf: rgba(35, 42, 60, 0.75);
      --surf-high: rgba(42, 50, 72, 0.88);
      --surf-highest: rgba(54, 64, 90, 0.95);
      --outline-variant: rgba(255, 255, 255, 0.14);
      --card-shadow: 0 8px 24px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.15);
      --glass-blur: blur(14px);
    }

    /* ==========================================================================
       2. LUCI-THEME-PIXEL MONOCHROME TOKENS (DEFAULT STYLE)
       - Sampled from Trendorin/luci-theme-pixel:
         Light screen: #E2E3E0 canvas, #EFEFED surface, #141514 ink
         Dark screen:  #0B0C0B canvas, #141614 surface, #D8DAD6 ink
         Screen wells (graphs/telemetry): always dark (#0B0C0B / #D8DAD6)
         Red: strictly #C62828 / #E53935 for errors & destructive actions
       ========================================================================== */
    [data-style="pixel"] {
      --bg: #E2E3E0;
      --surf-lowest: #EFEFED;
      --surf-low: #EFEFED;
      --surf: #E6E7E4;
      --surf-high: #D6D8D4;
      --surf-highest: #C7C9C5;
      --on-bg: #141514;
      --on-surface-variant: #4B4D4B;
      --outline: #141514;
      --outline-variant: #7E807D;

      --primary: #141514;
      --on-primary: #EFEFED;
      --primary-container: #141514;
      --on-primary-container: #EFEFED;
      --secondary-container: #141514;
      --on-secondary-container: #EFEFED;
      --tertiary-container: #D6D8D4;
      --on-tertiary-container: #141514;
      --warning-container: #D6D8D4;
      --on-warning-container: #141514;
      --success: #141514;

      --error: #C62828;
      --on-error: #FFFFFF;
      --error-container: #C62828;
      --on-error-container: #FFFFFF;

      --screen-bg: #0B0C0B;
      --screen-fg: #D8DAD6;
      --screen-dim: #7C7E7B;
      --scanline: rgba(20, 21, 20, 0.04);

      /* Stepped 4-corner pixel notch */
      --px-notch: polygon(
        0 4px, 4px 4px, 4px 0,
        calc(100% - 4px) 0, calc(100% - 4px) 4px, 100% 4px,
        100% calc(100% - 4px), calc(100% - 4px) calc(100% - 4px), calc(100% - 4px) 100%,
        4px 100%, 4px calc(100% - 4px), 0 calc(100% - 4px)
      );
      --px-notch-sm: polygon(
        0 2px, 2px 2px, 2px 0,
        calc(100% - 2px) 0, calc(100% - 2px) 2px, 100% 2px,
        100% calc(100% - 2px), calc(100% - 2px) calc(100% - 2px), calc(100% - 2px) 100%,
        2px 100%, 2px calc(100% - 2px), 0 calc(100% - 2px)
      );
    }

    [data-style="pixel"][data-theme="dark"] {
      --bg: #0B0C0B;
      --surf-lowest: #111311;
      --surf-low: #141614;
      --surf: #191B19;
      --surf-high: #222522;
      --surf-highest: #2C302C;
      --on-bg: #D8DAD6;
      --on-surface-variant: #888B87;
      --outline: #D8DAD6;
      --outline-variant: #4B4E4B;

      --primary: #D8DAD6;
      --on-primary: #0B0C0B;
      --primary-container: #D8DAD6;
      --on-primary-container: #0B0C0B;
      --secondary-container: #D8DAD6;
      --on-secondary-container: #0B0C0B;
      --tertiary-container: #222522;
      --on-tertiary-container: #D8DAD6;
      --warning-container: #222522;
      --on-warning-container: #D8DAD6;
      --success: #D8DAD6;

      --error: #E53935;
      --on-error: #FFFFFF;
      --error-container: #E53935;
      --on-error-container: #FFFFFF;

      --screen-bg: #060706;
      --screen-fg: #E4E6E2;
      --screen-dim: #7C7E7B;
      --scanline: rgba(255, 255, 255, 0.035);
    }

    /* ==========================================================================
       3. FINITE STEPPED ANIMATIONS (PIXEL MODE) & REDUCED MOTION
       ========================================================================== */
    @keyframes pxBootFlicker {
      0% { opacity: 0.25; }
      33% { opacity: 0.9; }
      66% { opacity: 0.55; }
      100% { opacity: 1; }
    }

    @keyframes pxCursorBlink6 {
      0%, 49% { opacity: 1; }
      50%, 100% { opacity: 0; }
    }

    @keyframes pxBlockWalk {
      0% { transform: translateX(0); }
      33% { transform: translateX(6px); }
      66% { transform: translateX(12px); }
      100% { transform: translateX(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
      }
      body::after { display: none !important; }
    }

    /* ==========================================================================
       4. BASE LAYOUT (MATERIAL 3 & GLASS SHARED)
       ========================================================================== */
    body {
      font-family: var(--font-sans);
      background: var(--bg);
      background-attachment: fixed;
      color: var(--on-bg);
      line-height: 1.4;
      padding: 10px 14px 105px 14px;
      max-width: 900px;
      margin: 0 auto;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .top-bar {
      position: sticky; top: 0; z-index: 40;
      padding: 6px 0 8px 0;
      display: flex; flex-direction: column; gap: 8px;
    }
    [data-style="m3"] .top-bar { background: var(--bg); }
    [data-style="glass"] .top-bar {
      background: var(--surf);
      backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
      margin: 0 -14px; padding: 8px 14px 10px 14px;
      border-bottom: 1px solid var(--outline-variant);
    }

    .bar-row { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .title-group { display: flex; align-items: center; gap: 6px; min-width: 0; }
    .app-title { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.02em; white-space: nowrap; }
    .px-subtitle { display: none; }

    .sync-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); flex-shrink: 0; }
    .sync-dot.syncing { background: var(--primary); }
    .sync-dot.err { background: var(--error); }
    .px-walker { display: none; }

    .top-actions { display: flex; gap: 5px; align-items: center; flex-shrink: 0; }
    .btn-icon {
      width: 34px; height: 34px; border-radius: var(--r-full);
      border: 1px solid var(--outline-variant);
      background: var(--surf); color: var(--on-bg);
      display: inline-flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 0.92rem;
    }
    .btn-pill {
      height: 34px; padding: 0 9px; border-radius: var(--r-full);
      border: 1px solid var(--outline-variant);
      background: var(--surf); color: var(--on-bg);
      display: inline-flex; align-items: center; gap: 4px;
      cursor: pointer; font-size: 0.74rem; font-weight: 800; white-space: nowrap;
    }

    .err-banner {
      background: var(--error-container); color: var(--on-error-container);
      border: 1px solid var(--error); border-radius: var(--r-md);
      padding: 8px 12px; display: none; justify-content: space-between; align-items: center; gap: 8px;
      font-size: 0.78rem; font-weight: 700;
    }

    /* System Health Panel */
    .sys-panel {
      background: var(--surf-low); border-radius: var(--r-md);
      border: 1px solid var(--outline-variant); box-shadow: var(--card-shadow);
      overflow: hidden;
    }
    .sys-head {
      padding: 7px 12px; display: flex; justify-content: space-between; align-items: center;
      cursor: pointer; font-size: 0.74rem; font-weight: 700; color: var(--on-surface-variant);
      user-select: none;
    }
    .sys-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;
      padding: 7px 12px 9px 12px; border-top: 1px dashed var(--outline-variant);
    }
    .sys-panel.collapsed .sys-grid { display: none; }
    .sys-item { display: flex; flex-direction: column; gap: 2px; }
    .sys-k { font-size: 0.6rem; font-weight: 700; color: var(--on-surface-variant); text-transform: uppercase; }
    .sys-v { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 800; }
    .seg-bar { display: none; }

    /* Traffic & Top 3 Strip */
    .overview-box {
      background: var(--surf-low); border-radius: var(--r-lg);
      padding: 9px 12px; border: 1px solid var(--outline-variant);
      box-shadow: var(--card-shadow);
      display: flex; flex-direction: column; gap: 8px;
    }
    .traffic-row { display: flex; justify-content: space-between; align-items: center; }
    .stat-box { display: flex; align-items: center; gap: 7px; }
    .dot { width: 8px; height: 8px; border-radius: 50%; }
    .dot.rx { background: var(--primary); } .dot.tx { background: var(--success); }
    .stat-lbl { font-size: 0.62rem; font-weight: 700; color: var(--on-surface-variant); text-transform: uppercase; }
    .stat-val { font-size: 0.88rem; font-weight: 800; font-family: var(--font-mono); }
    .stat-val.rx { color: var(--primary); } .stat-val.tx { color: var(--success); }

    .top3-row {
      display: flex; align-items: center; gap: 6px; overflow-x: auto; scrollbar-width: none;
      padding-top: 6px; border-top: 1px solid var(--outline-variant); font-size: 0.7rem;
    }
    .top3-row::-webkit-scrollbar { display: none; }
    .top3-lbl { font-weight: 800; color: var(--on-surface-variant); white-space: nowrap; }
    .top3-pill {
      display: inline-flex; align-items: center; gap: 4px;
      background: var(--surf); border: 1px solid var(--outline-variant);
      padding: 2px 8px; border-radius: var(--r-full); white-space: nowrap; cursor: pointer;
    }
    .top3-pill b { font-weight: 700; max-width: 90px; overflow: hidden; text-overflow: ellipsis; }
    .top3-pill span { font-family: var(--font-mono); color: var(--primary); font-weight: 800; }

    /* Search & Chips */
    .search-box {
      background: var(--surf-high); border-radius: var(--r-full); height: 40px;
      display: flex; align-items: center; padding: 0 14px; margin: 10px 0 8px 0;
      border: 1px solid var(--outline-variant);
    }
    .search-box input {
      border: none; background: transparent; outline: none; width: 100%;
      margin-left: 8px; font-size: 0.86rem; color: var(--on-bg);
    }
    .chips-row {
      display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin-bottom: 6px; align-items: center;
    }
    .chips-row::-webkit-scrollbar { display: none; }
    .chip {
      height: 30px; padding: 0 11px; border-radius: var(--r-sm);
      display: inline-flex; align-items: center; gap: 4px; font-size: 0.74rem; font-weight: 600;
      cursor: pointer; white-space: nowrap; border: 1px solid var(--outline-variant);
      background: var(--surf-lowest); color: var(--on-surface-variant); user-select: none;
    }
    .chip.active {
      background: var(--secondary-container); color: var(--on-secondary-container);
      border-color: transparent; font-weight: 800;
    }
    .chip.sort-chip.active { background: var(--primary-container); color: var(--on-primary-container); }
    .chip-sep { width: 1px; height: 18px; background: var(--outline-variant); flex-shrink: 0; margin: 0 2px; }

    /* Cards & Sparkline */
    .grid { display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 6px; }
    @media (min-width: 660px) { .grid { grid-template-columns: repeat(2, 1fr); } }

    .card {
      background: var(--surf-low); border-radius: var(--r-lg); padding: 12px;
      border: 1px solid var(--outline-variant); box-shadow: var(--card-shadow);
      display: flex; flex-direction: column; gap: 8px;
      contain: content; cursor: pointer; position: relative; user-select: none;
    }
    .card.offline { opacity: 0.65; background: var(--surf-lowest); }
    .card.pinned { border-color: var(--primary); }
    .card.selected { outline: 2px solid var(--primary); background: var(--primary-container); }

    .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
    .profile { display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1; }

    .sel-chk {
      width: 22px; height: 22px; border-radius: 6px; border: 2px solid var(--primary);
      display: none; align-items: center; justify-content: center; font-size: 0.85rem;
      font-weight: 900; flex-shrink: 0; background: var(--surf-lowest); color: var(--primary);
    }
    .select-mode .sel-chk { display: flex; }
    .card.selected .sel-chk { background: var(--primary); color: var(--on-primary); }

    .icon-btn {
      width: 40px; height: 40px; border-radius: var(--r-md);
      background: var(--primary-container); color: var(--on-primary-container);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; border: none; cursor: pointer; flex-shrink: 0; position: relative;
    }
    .pin-mark {
      position: absolute; top: -4px; left: -4px; font-size: 0.65rem;
      background: var(--primary); color: var(--on-primary); border-radius: 50%;
      width: 16px; height: 16px; display: none; align-items: center; justify-content: center;
    }
    .card.pinned .pin-mark { display: flex; }

    .names { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .name-row { display: flex; align-items: center; gap: 4px; min-width: 0; }
    .name-main { font-size: 0.94rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .btn-edit-name { border: none; background: transparent; color: var(--on-surface-variant); font-size: 0.78rem; padding: 2px 5px; cursor: pointer; opacity: 0.75; }
    .name-sub { font-size: 0.71rem; color: var(--on-surface-variant); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Switch */
    .switch-wrap { display: flex; flex-direction: column; align-items: center; gap: 2px; flex-shrink: 0; }
    .switch { position: relative; display: inline-block; width: 44px; height: 24px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .track {
      position: absolute; inset: 0; background: var(--surf-highest);
      border: 2px solid var(--outline); border-radius: var(--r-full); cursor: pointer;
    }
    .track::before {
      content: ""; position: absolute; height: 14px; width: 14px; left: 3px; bottom: 3px;
      background: var(--outline); border-radius: 50%; transition: transform 0.14s ease;
    }
    .switch input:checked + .track { background: var(--error); border-color: var(--error); }
    .switch input:checked + .track::before { transform: translateX(20px); background: var(--on-error); }
    .sw-lbl { font-size: 0.56rem; color: var(--on-surface-variant); font-weight: 800; }

    /* Tags & Segmented RSSI */
    .tags { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 3px; }
    .tag { font-size: 0.6rem; font-weight: 800; padding: 1px 6px; border-radius: var(--r-xs); text-transform: uppercase; }
    .t-rand { background: var(--tertiary-container); color: var(--on-tertiary-container); }
    .t-band { background: var(--surf-highest); color: var(--on-surface-variant); }
    .t-grp { background: var(--secondary-container); color: var(--on-secondary-container); }
    .t-blk { background: var(--error-container); color: var(--on-error-container); }
    .t-qos { background: var(--warning-container); color: var(--on-warning-container); }
    .t-new { background: var(--error); color: var(--on-error); }

    .rssi { display: inline-flex; align-items: flex-end; gap: 2px; height: 10px; margin-left: 4px; }
    .rssi i { width: 3px; background: var(--outline-variant); border-radius: 1px; font-style: normal; }
    .rssi i:nth-child(1) { height: 25%; } .rssi i:nth-child(2) { height: 50%; }
    .rssi i:nth-child(3) { height: 75%; } .rssi i:nth-child(4) { height: 100%; }
    .rssi[data-l="1"] i:nth-child(1) { background: var(--error); }
    .rssi[data-l="2"] i:nth-child(-n+2) { background: #FF9800; }
    .rssi[data-l="3"] i:nth-child(-n+3), .rssi[data-l="4"] i { background: var(--success); }

    /* Info & Sparkline Matrix */
    .matrix {
      background: var(--surf); border-radius: var(--r-md); padding: 6px 10px;
      display: grid; grid-template-columns: 1.1fr 1fr 68px; gap: 6px; align-items: center;
      font-size: 0.71rem;
    }
    .m-col { display: flex; flex-direction: column; min-width: 0; }
    .m-k { font-size: 0.58rem; font-weight: 700; color: var(--on-surface-variant); }
    .m-v { font-family: var(--font-mono); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .spark-svg { width: 68px; height: 24px; display: block; overflow: visible; }
    .spark-line { fill: none; stroke: var(--primary); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

    /* Card Bottom */
    .card-bot { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .spd { display: flex; gap: 7px; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 800; }
    .spd-d { color: var(--primary); } .spd-u { color: var(--success); }
    .btns { display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
    .btn-sm {
      border: 1px solid var(--outline-variant); background: var(--surf-high); color: var(--on-bg);
      padding: 4px 8px; border-radius: var(--r-sm); font-size: 0.69rem; font-weight: 700; cursor: pointer;
    }
    .btn-sm.tonal { background: var(--secondary-container); color: var(--on-secondary-container); border-color: transparent; }
    .btn-sm.danger { background: var(--error-container); color: var(--on-error-container); border-color: transparent; }

    /* Bulk, FAB & Bottom Nav */
    .bulk-bar {
      position: fixed; bottom: 72px; left: 12px; right: 12px; max-width: 876px; margin: 0 auto;
      background: var(--primary); color: var(--on-primary);
      border-radius: var(--r-lg); padding: 10px 14px;
      display: none; justify-content: space-between; align-items: center; gap: 8px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.28); z-index: 55;
    }
    .bulk-bar.show { display: flex; }
    .bulk-btns { display: flex; gap: 6px; flex-wrap: wrap; }
    .bulk-btn {
      border: none; background: rgba(255,255,255,0.2); color: inherit;
      padding: 6px 10px; border-radius: var(--r-sm); font-size: 0.74rem; font-weight: 800; cursor: pointer;
    }

    .fab {
      position: fixed; right: 16px; bottom: 76px; height: 48px; padding: 0 15px;
