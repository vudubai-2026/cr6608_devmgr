<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#F3F5EC" id="meta-theme">
  <title>CR6608 · PIXEL DEVMGR v5.1</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

    /* ==========================================================================
       GOOGLE PIXEL + RETRO PIXEL FONT DESIGN SYSTEM (ZERO EXTERNAL DEPS)
       ========================================================================== */
    :root {
      /* Crisp geometric pixel-style font stack using built-in OS fonts */
      --font-px: ui-monospace, "Cascadia Mono", "Consolas", "Courier New", monospace;
      --font-ui: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;

      /* Google Pixel Sage / Material You Dynamic Palette (Light) */
      --bg: #F3F5EC;
      --surf: #FFFFFF;
      --surf-2: #E8ECE0;
      --surf-3: #DCE2D1;
      --text: #141812;
      --text-dim: #4E5649;
      --border: #141812;
      --border-soft: #B8C2AE;

      --accent: #2E6B27;
      --accent-fg: #FFFFFF;
      --accent-soft: #C8F0BE;
      --accent-soft-fg: #0A2106;

      --warn: #B25E00;
      --warn-soft: #FFE0B5;
      --danger: #BA1A1A;
      --danger-soft: #FFDAD6;
      --info: #005AC1;
      --info-soft: #D8E2FF;

      --px-shadow: 3px 3px 0px #141812;
      --px-shadow-sm: 2px 2px 0px #141812;
    }

    [data-theme="dark"] {
      /* Google Pixel Dark OLED + Phosphor Sage */
      --bg: #10130E;
      --surf: #181D15;
      --surf-2: #22291E;
      --surf-3: #2C3527;
      --text: #E5ECE0;
      --text-dim: #9DA896;
      --border: #8FA184;
      --border-soft: #3B4635;

      --accent: #8CD97E;
      --accent-fg: #072104;
      --accent-soft: #1B4216;
      --accent-soft-fg: #C8F0BE;

      --warn: #FFB95C;
      --warn-soft: #4A2800;
      --danger: #FFB4AB;
      --danger-soft: #690005;
      --info: #ADC6FF;
      --info-soft: #00306C;

      --px-shadow: 3px 3px 0px #000000;
      --px-shadow-sm: 2px 2px 0px #000000;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }

    body {
      font-family: var(--font-ui);
      background-color: var(--bg);
      /* Subtle Pixel Dot Matrix Background */
      background-image: radial-gradient(var(--border-soft) 1px, transparent 1px);
      background-size: 16px 16px;
      color: var(--text);
      line-height: 1.4;
      font-size: 14px;
      padding-bottom: calc(82px + env(safe-area-inset-bottom));
      min-height: 100vh;
    }

    .px-font {
      font-family: var(--font-px);
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }

    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 0 12px;
    }

    /* ==========================================================================
       1. PIXEL TOP APP BAR
       ========================================================================== */
    .top-bar {
      position: sticky; top: 0; z-index: 40;
      background: var(--bg);
      border-bottom: 2px solid var(--border);
      padding: 10px 12px;
      margin: 0 -12px 12px -12px;
      display: flex; justify-content: space-between; align-items: center; gap: 8px;
    }
    .brand { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .px-logo {
      width: 30px; height: 30px; background: var(--accent); color: var(--accent-fg);
      border: 2px solid var(--border); box-shadow: var(--px-shadow-sm);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-px); font-weight: 900; font-size: 14px; flex-shrink: 0;
    }
    .brand-title {
      font-family: var(--font-px); font-size: 15px; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.02em; white-space: nowrap;
    }
    .live-pill {
      font-family: var(--font-px); font-size: 10px; font-weight: 800;
      padding: 2px 6px; border: 1.5px solid var(--border);
      background: var(--accent-soft); color: var(--accent-soft-fg);
      text-transform: uppercase; white-space: nowrap;
    }
    .live-pill.syncing { background: var(--info-soft); color: var(--info); }
    .live-pill.err { background: var(--danger-soft); color: var(--danger); }

    .top-btns { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .px-btn {
      height: 32px; padding: 0 9px;
      background: var(--surf); color: var(--text);
      border: 2px solid var(--border); box-shadow: var(--px-shadow-sm);
      font-family: var(--font-px); font-size: 11px; font-weight: 800;
      cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 4px;
      text-transform: uppercase;
    }
    .px-btn:active { transform: translate(2px, 2px); box-shadow: none; }
    .px-btn.accent { background: var(--accent); color: var(--accent-fg); }
    .px-btn.danger { background: var(--danger); color: #FFF; }
    .px-btn.soft { background: var(--surf-2); }

    /* Error Banner */
    .err-banner {
      background: var(--danger-soft); color: var(--danger);
      border: 2px solid var(--danger); box-shadow: var(--px-shadow-sm);
      padding: 8px 10px; margin-bottom: 12px;
      display: none; justify-content: space-between; align-items: center; gap: 8px;
      font-family: var(--font-px); font-size: 11.5px; font-weight: 700;
    }

    /* ==========================================================================
       2. PIXEL AT-A-GLANCE WIDGET (GOOGLE PIXEL STYLE + TELEMETRY)
       ========================================================================== */
    .pixel-widget {
      background: var(--surf);
      border: 2px solid var(--border);
      box-shadow: var(--px-shadow);
      padding: 12px;
      margin-bottom: 12px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .widget-head {
      display: flex; justify-content: space-between; align-items: center;
      font-family: var(--font-px); font-size: 11px; font-weight: 800; color: var(--text-dim);
      text-transform: uppercase;
    }
    .kpi-row {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
    }
    .kpi-cell {
      background: var(--surf-2); border: 1.5px solid var(--border);
      padding: 7px 8px; display: flex; flex-direction: column; gap: 2px;
    }
    .kpi-k { font-family: var(--font-px); font-size: 10px; font-weight: 700; color: var(--text-dim); text-transform: uppercase; }
    .kpi-v { font-family: var(--font-px); font-size: 13.5px; font-weight: 900; }
    .kpi-v.rx { color: var(--info); }
    .kpi-v.tx { color: var(--accent); }

    /* Hardware System Health Bars */
    .sys-strip {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;
      padding-top: 8px; border-top: 1.5px dashed var(--border-soft);
      font-family: var(--font-px); font-size: 11px;
    }
    .sys-box { display: flex; flex-direction: column; gap: 2px; }
    .sys-lbl { font-size: 9.5px; color: var(--text-dim); font-weight: 700; }
    .sys-val { font-weight: 900; }
    .px-meter {
      height: 6px; background: var(--surf-3); border: 1px solid var(--border);
      margin-top: 2px; overflow: hidden;
    }
    .px-meter > i { display: block; height: 100%; background: var(--accent); font-style: normal; }

    /* Top 3 Consumers */
    .top3-strip {
      display: flex; align-items: center; gap: 6px; overflow-x: auto; scrollbar-width: none;
      padding-top: 8px; border-top: 1.5px dashed var(--border-soft);
    }
    .top3-strip::-webkit-scrollbar { display: none; }
    .top3-chip {
      background: var(--surf-2); border: 1.5px solid var(--border);
      padding: 3px 8px; font-family: var(--font-px); font-size: 11px;
      display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; cursor: pointer;
      color: var(--text);
    }
    .top3-chip b { max-width: 85px; overflow: hidden; text-overflow: ellipsis; }
    .top3-chip span { color: var(--info); font-weight: 900; }

    /* ==========================================================================
       3. PIXEL SEARCH, FILTER & SORT BAR
       ========================================================================== */
    .controls { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
    .search-box {
      display: flex; align-items: center; background: var(--surf);
      border: 2px solid var(--border); box-shadow: var(--px-shadow-sm);
      height: 40px; padding: 0 10px; gap: 8px;
    }
    .search-box input {
      border: none; background: transparent; outline: none; width: 100%;
      color: var(--text); font-family: var(--font-px); font-size: 12.5px; font-weight: 700;
    }
    .chip-scroll {
      display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; align-items: center; padding-bottom: 2px;
    }
    .chip-scroll::-webkit-scrollbar { display: none; }
    .px-chip {
      height: 28px; padding: 0 9px;
      background: var(--surf); color: var(--text-dim);
      border: 1.5px solid var(--border);
      font-family: var(--font-px); font-size: 11px; font-weight: 800;
      white-space: nowrap; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;
    }
    .px-chip.active {
      background: var(--accent-soft); color: var(--accent-soft-fg);
      box-shadow: var(--px-shadow-sm);
    }
    .px-chip.sort.active {
      background: var(--info-soft); color: var(--info);
    }

    /* ==========================================================================
       4. DEVICE CARDS (PIXEL BLOCK GRID + TACTILE CONTROLS)
       ========================================================================== */
    .grid {
      display: grid; grid-template-columns: 1fr; gap: 10px;
    }
    @media (min-width: 680px) { .grid { grid-template-columns: repeat(2, 1fr); } }

    .card {
      background: var(--surf);
      border: 2px solid var(--border);
      box-shadow: var(--px-shadow);
      padding: 11px 12px;
      display: flex; flex-direction: column; gap: 9px;
      contain: content; cursor: pointer; user-select: none; position: relative;
    }
    .card.offline { opacity: 0.72; background: var(--surf-2); box-shadow: none; }
    .card.pinned { border-top: 5px solid var(--accent); }
    .card.selected { background: var(--accent-soft); }

    .c-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
    .c-left { display: flex; align-items: center; gap: 9px; min-width: 0; flex: 1; }

    .sel-box {
      width: 20px; height: 20px; border: 2px solid var(--border); background: var(--surf);
      display: none; align-items: center; justify-content: center;
      font-family: var(--font-px); font-weight: 900; font-size: 12px; flex-shrink: 0;
    }
    .select-mode .sel-box { display: flex; }
    .card.selected .sel-box { background: var(--accent); color: var(--accent-fg); }

    .ico-tile {
      width: 40px; height: 40px;
      background: var(--surf-2); border: 2px solid var(--border); box-shadow: var(--px-shadow-sm);
      font-size: 20px; display: flex; align-items: center; justify-content: center;
      cursor: pointer; flex-shrink: 0; position: relative;
    }
    .ico-tile:active { transform: translate(2px, 2px); box-shadow: none; }
    .pin-flag {
      position: absolute; top: -6px; left: -6px; font-size: 11px;
      background: var(--accent); color: var(--accent-fg); border: 1.5px solid var(--border);
      padding: 0 3px; display: none;
    }
    .card.pinned .pin-flag { display: block; }

    .c-info { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .c-name-row { display: flex; align-items: center; gap: 4px; }
    .c-name {
      font-size: 14.5px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .btn-pen {
      border: none; background: transparent; color: var(--text-dim);
      font-family: var(--font-px); font-size: 13px; padding: 2px 4px; cursor: pointer;
    }
    .c-meta {
      font-family: var(--font-px); font-size: 11px; color: var(--text-dim);
      display: flex; align-items: center; gap: 5px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* Pixel Block Switch */
    .sw-wrap { display: flex; flex-direction: column; align-items: center; gap: 2px; flex-shrink: 0; }
    .px-sw { position: relative; display: inline-block; width: 44px; height: 24px; }
    .px-sw input { opacity: 0; width: 0; height: 0; }
    .px-track {
      position: absolute; inset: 0; background: var(--surf-3);
      border: 2px solid var(--border); cursor: pointer;
    }
    .px-track::before {
      content: ""; position: absolute; width: 14px; height: 14px; left: 3px; top: 3px;
      background: var(--text-dim); border: 1.5px solid var(--border);
      transition: transform 0.12s steps(2);
    }
    .px-sw input:checked + .px-track { background: var(--danger); }
    .px-sw input:checked + .px-track::before {
      transform: translateX(20px); background: #FFFFFF;
    }
    .sw-txt { font-family: var(--font-px); font-size: 9px; font-weight: 900; color: var(--text-dim); }

    /* Tags */
    .tags { display: flex; gap: 4px; flex-wrap: wrap; }
    .tag {
      font-family: var(--font-px); font-size: 10px; font-weight: 800;
      padding: 1px 6px; border: 1.5px solid var(--border);
      background: var(--surf-2); color: var(--text); text-transform: uppercase;
    }
    .tag.grp { background: var(--info-soft); color: var(--info); }
    .tag.qos { background: var(--warn-soft); color: var(--warn); }
    .tag.blk { background: var(--danger-soft); color: var(--danger); }
    .tag.new { background: var(--accent); color: var(--accent-fg); }

    /* Pixel RSSI Bars */
    .rssi { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; }
    .rssi i { width: 3px; background: var(--border-soft); font-style: normal; }
    .rssi i:nth-child(1) { height: 25%; } .rssi i:nth-child(2) { height: 50%; }
    .rssi i:nth-child(3) { height: 75%; } .rssi i:nth-child(4) { height: 100%; }
    .rssi[data-l="1"] i:nth-child(1) { background: var(--danger); }
    .rssi[data-l="2"] i:nth-child(-n+2) { background: var(--warn); }
    .rssi[data-l="3"] i:nth-child(-n+3), .rssi[data-l="4"] i { background: var(--accent); }

    /* Telemetry Strip (IP/MAC + Speed + Pixel Sparkline) */
    .net-box {
      background: var(--surf-2); border: 1.5px solid var(--border);
      padding: 6px 8px; display: flex; justify-content: space-between; align-items: center; gap: 8px;
    }
    .addrs { display: flex; flex-direction: column; gap: 2px; font-family: var(--font-px); font-size: 11px; min-width: 0; }
    .cp-btn {
      border: none; background: transparent; padding: 0; text-align: left;
      color: var(--text); font-family: inherit; font-size: inherit; cursor: pointer;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cp-btn span { color: var(--text-dim); font-size: 10px; }

    .spd-box { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .spd-nums { display: flex; flex-direction: column; align-items: flex-end; font-family: var(--font-px); font-size: 11px; font-weight: 900; }
    .spd-d { color: var(--info); }
    .spd-u { color: var(--accent); }
    .spark { width: 54px; height: 22px; display: block; }
    .spark polyline { fill: none; stroke: var(--accent); stroke-width: 2; shape-rendering: crispEdges; }

    /* Card Action Row */
    .c-foot { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .foot-l { display: flex; gap: 5px; flex-wrap: wrap; }
    .act-btn {
      height: 27px; padding: 0 7px;
      background: var(--surf); color: var(--text);
      border: 1.5px solid var(--border); box-shadow: var(--px-shadow-sm);
      font-family: var(--font-px); font-size: 10.5px; font-weight: 800; cursor: pointer;
      text-transform: uppercase;
    }
    .act-btn:active { transform: translate(1px, 1px); box-shadow: none; }
    .act-btn.info { background: var(--info-soft); color: var(--info); }
    .act-btn.warn { background: var(--warn-soft); color: var(--warn); }
    .act-btn.danger { background: var(--danger-soft); color: var(--danger); }

    /* ==========================================================================
       5. BULK BAR, PIXEL FAB & BOTTOM NAVIGATION
       ========================================================================== */
    .bulk-bar {
      position: fixed; bottom: calc(68px + env(safe-area-inset-bottom)); left: 12px; right: 12px;
      max-width: 956px; margin: 0 auto;
      background: var(--accent); color: var(--accent-fg);
      border: 2px solid var(--border); box-shadow: var(--px-shadow);
      padding: 8px 12px; display: none; justify-content: space-between; align-items: center; z-index: 45;
    }
    .bulk-bar.show { display: flex; }

    .fab-px {
      position: fixed; right: 16px; bottom: calc(72px + env(safe-area-inset-bottom));
      height: 44px; padding: 0 14px;
      background: var(--accent); color: var(--accent-fg);
      border: 2px solid var(--border); box-shadow: var(--px-shadow);
      font-family: var(--font-px); font-size: 12px; font-weight: 900;
      cursor: pointer; z-index: 35; display: flex; align-items: center; gap: 6px;
      text-transform: uppercase;
    }
    .fab-px:active { transform: translate(2px, 2px); box-shadow: none; }

    .bottom-nav {
      position: fixed; bottom: 0; left: 0; right: 0;
      height: calc(58px + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--surf); border-top: 2px solid var(--border);
      display: flex; z-index: 40;
    }
    .nav-item {
      flex: 1; border: none; background: transparent; color: var(--text-dim);
      font-family: var(--font-px); font-size: 12px; font-weight: 800;
      cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;
      text-transform: uppercase;
    }
    .nav-item + .nav-item { border-left: 2px solid var(--border); }
    .nav-item.active {
      background: var(--accent-soft); color: var(--accent-soft-fg); font-weight: 900;
    }

    /* ==========================================================================
       6. PIXEL MODALS & BOTTOM SHEET
       ========================================================================== */
    .scrim {
      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55);
      display: flex; align-items: center; justify-content: center; padding: 14px; z-index: 100;
    }
    .scrim.sheet { align-items: flex-end; padding: 0; }
    .scrim[hidden] { display: none; }

    .dialog {
      background: var(--surf); border: 2px solid var(--border); box-shadow: var(--px-shadow);
      padding: 16px; width: 100%; max-width: 460px; max-height: 88vh; overflow-y: auto;
    }
    .scrim.sheet .dialog {
      max-width: 680px; border-bottom: none; box-shadow: 0 -4px 0 var(--border);
      padding-bottom: calc(22px + env(safe-area-inset-bottom));
    }
    .dlg-h { font-family: var(--font-px); font-size: 15px; font-weight: 900; margin-bottom: 4px; text-transform: uppercase; }
    .dlg-p { font-size: 12.5px; color: var(--text-dim); margin-bottom: 12px; }
    .px-input, select.px-input {
      width: 100%; height: 38px; padding: 0 10px;
      border: 2px solid var(--border); background: var(--surf-2); color: var(--text);
      font-family: var(--font-px); font-size: 13px; font-weight: 700; margin-bottom: 10px; outline: none;
    }
    .px-lbl { font-family: var(--font-px); font-size: 11px; font-weight: 800; color: var(--text-dim); margin-bottom: 4px; display: block; text-transform: uppercase; }
    .dlg-foot { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }

    .kv-box {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
      background: var(--surf-2); border: 1.5px solid var(--border);
      padding: 10px; margin-bottom: 12px;
    }
    .kv-k { font-family: var(--font-px); font-size: 10px; color: var(--text-dim); font-weight: 700; text-transform: uppercase; }
    .kv-v { font-family: var(--font-px); font-size: 12px; font-weight: 900; word-break: break-all; }

    .sheet-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
    .icon-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; max-height: 200px; overflow-y: auto; margin-bottom: 10px; }
    .icon-opt {
      height: 40px; border: 1.5px solid var(--border); background: var(--surf-2);
      font-size: 18px; cursor: pointer;
    }
    .icon-opt.sel { background: var(--accent-soft); border-width: 2.5px; }

    .toast-box {
      position: fixed; bottom: calc(70px + env(safe-area-inset-bottom)); left: 12px; right: 12px;
      display: flex; flex-direction: column; align-items: center; gap: 6px; z-index: 120; pointer-events: none;
    }
    .toast {
      padding: 8px 14px; background: var(--text); color: var(--bg);
      border: 2px solid var(--border); box-shadow: var(--px-shadow-sm);
      font-family: var(--font-px); font-size: 11.5px; font-weight: 800;
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- 1. PIXEL TOP BAR -->
    <header class="top-bar">
      <div class="brand">
        <div class="px-logo">PX</div>
        <span class="brand-title">CR6608</span>
        <span class="live-pill" id="sync-pill">ONLINE</span>
      </div>
      <div class="top-btns">
        <button type="button" class="px-btn" id="btn-poll" title="Chu kỳ làm mới">⏱ 5S</button>
        <button type="button" class="px-btn" id="btn-theme" title="Sáng / Tối">🌓</button>
        <button type="button" class="px-btn" id="btn-tools" title="Công cụ & Cài đặt">⚙️</button>
        <button type="button" class="px-btn accent" id="btn-refresh" title="Làm mới">↻</button>
      </div>
    </header>

    <div class="err-banner" id="err-banner">
      <span id="err-msg">MẤT KẾT NỐI ROUTER CR6608</span>
      <button type="button" class="px-btn" id="btn-retry">THỬ LẠI</button>
    </div>

    <!-- 2. PIXEL AT-A-GLANCE WIDGET -->
    <section class="pixel-widget">
      <div class="widget-head">
