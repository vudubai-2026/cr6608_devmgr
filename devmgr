  <!-- Universal 1-Bit / M3 / Glass Dialog & Bottom Sheet -->
  <div class="scrim hidden" id="dlg-scrim">
    <div class="dialog" id="dlg-box">
      <div class="dlg-titlebar">
        <span>[ CR6608.SYS ]</span>
        <span>[ X ]</span>
