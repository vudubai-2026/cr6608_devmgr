<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Xiaomi CR6608 - Quản lý thiết bị</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

    :root {
      --bg: #f3f4f6;
      --card: #ffffff;
      --card-sub: #f9fafb;
      --text: #111827;
      --text-muted: #6b7280;
      --border: #e5e7eb;
      --primary: #2563eb;
      --primary-bg: #eff6ff;
      --danger: #dc2626;
      --danger-bg: #fef2f2;
      --success: #16a34a;
      --success-bg: #f0fdf4;
      --warn: #d97706;
      --warn-bg: #fffbeb;
      --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    [data-theme="dark"] {
      --bg: #111827;
      --card: #1f2937;
      --card-sub: #18202c;
      --text: #f9fafb;
      --text-muted: #9ca3af;
      --border: #374151;
      --primary: #60a5fa;
      --primary-bg: #1e3a8a;
      --danger: #f87171;
      --danger-bg: #7f1d1d;
      --success: #4ade80;
      --success-bg: #14532d;
      --warn: #fbbf24;
      --warn-bg: #78350f;
    }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      line-height: 1.4;
      font-size: 14px;
      padding-bottom: calc(76px + env(safe-area-inset-bottom));
    }

    .container {
      max-width: 960px;
      margin: 0 auto;
      padding: 0 12px;
    }

    /* 1. HEADER & PURPOSEFUL TOP BAR */
    .header {
      position: sticky; top: 0; z-index: 30;
      background: var(--card);
      border-bottom: 1px solid var(--border);
      padding: 10px 12px;
      margin: 0 -12px 10px -12px;
      display: flex; justify-content: space-between; align-items: center; gap: 8px;
    }
    .header-left { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .header-title { font-size: 16px; font-weight: 700; white-space: nowrap; }
    .status-dot {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 4px;
      background: var(--success-bg); color: var(--success);
    }
    .status-dot.syncing { background: var(--primary-bg); color: var(--primary); }
    .status-dot.err { background: var(--danger-bg); color: var(--danger); }

    .header-actions { display: flex; align-items: center; gap: 6px; }
    .btn-top {
      height: 32px; padding: 0 10px; border-radius: 6px;
      border: 1px solid var(--border); background: var(--card-sub); color: var(--text);
      font-size: 12px; font-weight: 600; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 4px;
    }
    .btn-top:active { opacity: 0.75; }

    /* 2. OVERVIEW KPI & SYSTEM TELEMETRY */
    .overview {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      margin-bottom: 10px;
      display: flex; flex-direction: column; gap: 8px;
    }
    .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .kpi-box {
      background: var(--card-sub); border: 1px solid var(--border);
      border-radius: 6px; padding: 6px 8px;
    }
    .kpi-lbl { font-size: 11px; color: var(--text-muted); font-weight: 600; }
    .kpi-val { font-family: var(--mono); font-size: 13px; font-weight: 700; margin-top: 1px; }

    .sys-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding-top: 6px; border-top: 1px solid var(--border);
      font-size: 11px; color: var(--text-muted); font-family: var(--mono);
    }
    .top3-bar {
      display: flex; align-items: center; gap: 6px; overflow-x: auto; scrollbar-width: none;
      padding-top: 6px; border-top: 1px solid var(--border); font-size: 11px;
    }
    .top3-bar::-webkit-scrollbar { display: none; }
    .top3-tag {
      padding: 2px 7px; border-radius: 4px; border: 1px solid var(--border);
      background: var(--card-sub); white-space: nowrap; cursor: pointer;
      display: inline-flex; align-items: center; gap: 4px; color: var(--text);
    }
    .top3-tag b { font-weight: 600; max-width: 85px; overflow: hidden; text-overflow: ellipsis; }
    .top3-tag span { font-family: var(--mono); color: var(--primary); font-weight: 700; }

    /* 3. SEARCH, FILTER & SORT CONTROLS */
    .controls { display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px; }
    .search-wrap { position: relative; display: flex; align-items: center; }
    .search-input {
      width: 100%; height: 38px; padding: 0 32px 0 12px;
      border-radius: 6px; border: 1px solid var(--border);
      background: var(--card); color: var(--text); font-size: 13px; outline: none;
    }
    .search-input:focus { border-color: var(--primary); }
    .search-clear {
      position: absolute; right: 6px; width: 24px; height: 24px;
      border: none; background: transparent; color: var(--text-muted);
      cursor: pointer; display: none; font-size: 13px;
    }

    .filter-row {
      display: flex; gap: 5px; overflow-x: auto; scrollbar-width: none; align-items: center;
    }
    .filter-row::-webkit-scrollbar { display: none; }
    .pill {
      height: 28px; padding: 0 9px; border-radius: 5px;
      border: 1px solid var(--border); background: var(--card); color: var(--text-muted);
      font-size: 12px; font-weight: 600; white-space: nowrap; cursor: pointer;
    }
    .pill.active {
      background: var(--primary); color: #ffffff; border-color: var(--primary);
    }
    .sep { width: 1px; height: 16px; background: var(--border); flex-shrink: 0; }

    .err-box {
      background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger);
      border-radius: 6px; padding: 8px 12px; margin-bottom: 10px;
      display: none; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 600;
    }

    /* 4. DEVICE LIST & PURPOSEFUL CARD LAYOUT */
    .device-grid {
      display: grid; grid-template-columns: 1fr; gap: 8px;
    }
    @media (min-width: 680px) { .device-grid { grid-template-columns: repeat(2, 1fr); } }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      display: flex; flex-direction: column; gap: 8px;
      contain: content; cursor: pointer; user-select: none;
    }
    .card.offline { opacity: 0.68; background: var(--card-sub); }
    .card.pinned { border-left: 3px solid var(--primary); }
    .card.selected { border-color: var(--primary); background: var(--primary-bg); }

    /* Row 1: Identity + Block Switch */
    .c-row1 { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
    .c-id { display: flex; align-items: center; gap: 9px; min-width: 0; flex: 1; }
    .chk-sel {
      width: 18px; height: 18px; border-radius: 4px; border: 1.5px solid var(--primary);
      display: none; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 800; flex-shrink: 0; background: var(--card); color: var(--primary);
    }
    .select-mode .chk-sel { display: flex; }
    .card.selected .chk-sel { background: var(--primary); color: #fff; }

    .ico-btn {
      width: 36px; height: 36px; border-radius: 6px;
      border: 1px solid var(--border); background: var(--card-sub);
      font-size: 18px; display: flex; align-items: center; justify-content: center;
      cursor: pointer; flex-shrink: 0; position: relative;
    }
    .pin-badge {
      position: absolute; top: -5px; left: -5px; font-size: 10px;
      display: none;
    }
    .card.pinned .pin-badge { display: block; }

    .c-names { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .c-title-wrap { display: flex; align-items: center; gap: 4px; }
    .c-name {
      font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .btn-rename {
      border: none; background: transparent; color: var(--text-muted);
      font-size: 13px; padding: 2px 4px; cursor: pointer;
    }
    .c-sub {
      font-size: 11.5px; color: var(--text-muted);
      display: flex; align-items: center; gap: 5px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* Compact Toggle Switch */
    .sw-box { display: flex; flex-direction: column; align-items: center; gap: 2px; flex-shrink: 0; }
    .sw { position: relative; display: inline-block; width: 40px; height: 22px; }
    .sw input { opacity: 0; width: 0; height: 0; }
    .sw-slider {
      position: absolute; inset: 0; background: #cbd5e1; border-radius: 22px;
      cursor: pointer; transition: background 0.15s;
    }
    [data-theme="dark"] .sw-slider { background: #4b5563; }
    .sw-slider::before {
      content: ""; position: absolute; width: 16px; height: 16px; left: 3px; bottom: 3px;
      background: #ffffff; border-radius: 50%; transition: transform 0.15s;
    }
    .sw input:checked + .sw-slider { background: var(--danger); }
    .sw input:checked + .sw-slider::before { transform: translateX(18px); }
    .sw-lbl { font-size: 9.5px; font-weight: 700; color: var(--text-muted); }

    /* Tags */
    .c-tags { display: flex; gap: 4px; flex-wrap: wrap; }
    .tag {
      font-size: 10.5px; font-weight: 600; padding: 1px 6px; border-radius: 4px;
      background: var(--card-sub); border: 1px solid var(--border); color: var(--text-muted);
    }
    .tag.grp { background: var(--primary-bg); color: var(--primary); border-color: transparent; }
    .tag.qos { background: var(--warn-bg); color: var(--warn); border-color: transparent; }
    .tag.blk { background: var(--danger-bg); color: var(--danger); border-color: transparent; }
    .tag.new { background: var(--danger); color: #ffffff; border-color: transparent; }

    /* RSSI Bars */
    .rssi { display: inline-flex; align-items: flex-end; gap: 1.5px; height: 10px; }
    .rssi i { width: 2.5px; background: var(--border); font-style: normal; }
    .rssi i:nth-child(1) { height: 30%; } .rssi i:nth-child(2) { height: 55%; }
    .rssi i:nth-child(3) { height: 80%; } .rssi i:nth-child(4) { height: 100%; }
    .rssi[data-l="1"] i:nth-child(1) { background: var(--danger); }
    .rssi[data-l="2"] i:nth-child(-n+2) { background: var(--warn); }
    .rssi[data-l="3"] i:nth-child(-n+3), .rssi[data-l="4"] i { background: var(--success); }

    /* Row 2: Network Telemetry (IP/MAC + Speed + Sparkline) */
    .c-net {
      background: var(--card-sub); border: 1px solid var(--border); border-radius: 6px;
      padding: 6px 8px; display: flex; justify-content: space-between; align-items: center; gap: 8px;
    }
    .net-addrs { display: flex; flex-direction: column; gap: 2px; font-family: var(--mono); font-size: 11.5px; min-width: 0; }
    .copy-link {
      border: none; background: transparent; padding: 0; text-align: left;
      color: var(--text); font-family: inherit; font-size: inherit; cursor: pointer;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .copy-link span { color: var(--text-muted); font-size: 10.5px; }

    .net-spd { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .spd-col { display: flex; flex-direction: column; align-items: flex-end; font-family: var(--mono); font-size: 11px; font-weight: 700; }
    .spd-rx { color: var(--primary); }
    .spd-tx { color: var(--success); }
    .spark { width: 52px; height: 22px; display: block; }
    .spark polyline { fill: none; stroke: var(--primary); stroke-width: 1.6; }

    /* Row 3: Purposeful Action Buttons */
    .c-acts { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .act-left { display: flex; gap: 5px; flex-wrap: wrap; }
    .btn-act {
      height: 28px; padding: 0 8px; border-radius: 5px;
      border: 1px solid var(--border); background: var(--card); color: var(--text);
      font-size: 11.5px; font-weight: 600; cursor: pointer;
    }
    .btn-act:active { opacity: 0.7; }
    .btn-act.primary { background: var(--primary-bg); color: var(--primary); border-color: transparent; }
    .btn-act.danger { background: var(--danger-bg); color: var(--danger); border-color: transparent; }

    /* 5. BULK BAR, FAB & BOTTOM TABS */
    .bulk-bar {
      position: fixed; bottom: calc(64px + env(safe-area-inset-bottom)); left: 12px; right: 12px;
      max-width: 936px; margin: 0 auto;
      background: var(--primary); color: #ffffff;
      border-radius: 8px; padding: 8px 12px;
      display: none; justify-content: space-between; align-items: center; z-index: 45;
    }
    .bulk-bar.show { display: flex; }
    .bulk-btns { display: flex; gap: 6px; }
    .bulk-btn {
      height: 28px; padding: 0 10px; border-radius: 5px; border: none;
      background: rgba(255,255,255,0.22); color: #ffffff; font-size: 12px; font-weight: 600; cursor: pointer;
    }

    .fab-add {
      position: fixed; right: 16px; bottom: calc(68px + env(safe-area-inset-bottom));
      height: 42px; padding: 0 14px; border-radius: 8px;
      background: var(--primary); color: #ffffff; border: none;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      font-size: 13px; font-weight: 700; cursor: pointer; z-index: 35;
      display: flex; align-items: center; gap: 6px;
    }

    .bottom-nav {
      position: fixed; bottom: 0; left: 0; right: 0;
      height: calc(54px + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--card); border-top: 1px solid var(--border);
      display: flex; z-index: 40;
    }
    .nav-tab {
      flex: 1; border: none; background: transparent; color: var(--text-muted);
      font-size: 13px; font-weight: 600; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 6px;
      border-top: 2px solid transparent;
    }
    .nav-tab.active {
      color: var(--primary); border-top-color: var(--primary); font-weight: 700;
    }

    /* 6. MODALS & DETAIL DRAWER */
    .scrim {
      position: fixed; inset: 0; background: rgba(0,0,0,0.45);
      display: flex; align-items: center; justify-content: center; padding: 14px; z-index: 100;
    }
    .scrim.sheet { align-items: flex-end; padding: 0; }
    .scrim[hidden] { display: none; }

    .modal {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 10px; padding: 16px; width: 100%; max-width: 440px;
      max-height: 88vh; overflow-y: auto;
    }
    .scrim.sheet .modal {
      max-width: 640px; border-radius: 12px 12px 0 0;
      padding-bottom: calc(20px + env(safe-area-inset-bottom));
    }
    .m-title { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
    .m-desc { font-size: 12.5px; color: var(--text-muted); margin-bottom: 12px; }
    .m-input, select.m-input {
      width: 100%; height: 38px; padding: 0 10px; border-radius: 6px;
      border: 1px solid var(--border); background: var(--card-sub); color: var(--text);
      font-size: 13px; margin-bottom: 10px; outline: none;
    }
    .m-input:focus { border-color: var(--primary); }
    .m-lbl { font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; display: block; }
    .m-footer { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }

    .kv-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
      background: var(--card-sub); border: 1px solid var(--border);
      border-radius: 6px; padding: 10px; margin-bottom: 12px;
    }
    .kv-item { display: flex; flex-direction: column; }
    .kv-k { font-size: 10.5px; color: var(--text-muted); font-weight: 600; }
    .kv-v { font-family: var(--mono); font-size: 12px; font-weight: 700; word-break: break-all; }

    .sheet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
    .btn-block {
      height: 38px; border-radius: 6px; border: 1px solid var(--border);
      background: var(--card-sub); color: var(--text); font-size: 12.5px; font-weight: 600; cursor: pointer;
    }
    .btn-block.primary { background: var(--primary); color: #ffffff; border-color: var(--primary); }
    .btn-block.danger { background: var(--danger); color: #ffffff; border-color: var(--danger); }

    .icon-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; max-height: 200px; overflow-y: auto; margin-bottom: 10px; }
    .icon-cell {
      height: 40px; border-radius: 6px; border: 1px solid var(--border);
      background: var(--card-sub); font-size: 18px; cursor: pointer;
    }
    .icon-cell.sel { border-color: var(--primary); background: var(--primary-bg); border-width: 2px; }

    .toast-wrap {
      position: fixed; bottom: calc(68px + env(safe-area-inset-bottom)); left: 12px; right: 12px;
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      z-index: 120; pointer-events: none;
    }
    .toast {
      padding: 8px 14px; border-radius: 6px; font-size: 12.5px; font-weight: 600;
      background: #1f2937; color: #ffffff; box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }
    [data-theme="dark"] .toast { background: #f3f4f6; color: #111827; }
  </style>
</head>
<body>

  <div class="container">
    <!-- 1. TOP HEADER -->
    <header class="header">
      <div class="header-left">
        <span class="header-title">Xiaomi CR6608</span>
        <span class="status-dot" id="sync-badge">● Online</span>
      </div>
      <div class="header-actions">
        <button type="button" class="btn-top" id="btn-poll" title="Chu kỳ tự động cập nhật">⏱ 5s</button>
        <button type="button" class="btn-top" id="btn-theme" title="Đổi giao diện Sáng/Tối">🌓</button>
        <button type="button" class="btn-top" id="btn-settings" title="Cài đặt & Khởi động lại">⚙️</button>
        <button type="button" class="btn-top" id="btn-refresh" title="Làm mới ngay">↻</button>
      </div>
    </header>

    <div class="err-box" id="err-box">
      <span id="err-msg">Mất kết nối tới Router CR6608.</span>
      <button type="button" class="btn-act" id="btn-retry">Thử lại</button>
    </div>

    <!-- 2. SUMMARY & TELEMETRY -->
    <section class="overview">
      <div class="kpi-grid">
        <div class="kpi-box">
          <div class="kpi-lbl">↓ Tải xuống</div>
          <div class="kpi-val" id="tot-rx">0 B/s</div>
        </div>
        <div class="kpi-box">
          <div class="kpi-lbl">↑ Tải lên</div>
          <div class="kpi-val" id="tot-tx">0 B/s</div>
        </div>
        <div class="kpi-box">
          <div class="kpi-lbl">Thiết bị Online</div>
          <div class="kpi-val" id="tot-cnt">0 / 0</div>
        </div>
      </div>

      <!-- Router Hardware Status (Auto-hidden if "sys" absent) -->
      <div class="sys-bar" id="sys-bar" style="display:none">
        <span>CPU: <b id="sys-load">-</b></span>
        <span>RAM: <b id="sys-mem">-</b></span>
        <span>Uptime: <b id="sys-up">-</b></span>
        <span>Clients: <b id="sys-cli">-</b></span>
      </div>

      <!-- Top 3 Bandwidth Consumers -->
      <div class="top3-bar" id="top3-bar" style="display:none">
        <span style="color:var(--text-muted);font-weight:700;white-space:nowrap">Top 3:</span>
        <div id="top3-list" style="display:flex;gap:6px"></div>
      </div>
    </section>

    <!-- 3. SEARCH, FILTER & SORT -->
    <section class="controls">
      <div class="search-wrap">
        <input type="search" class="search-input" id="search" placeholder="Tìm tên máy, IP, MAC, hãng, nhóm..." autocomplete="off">
        <button type="button" class="search-clear" id="search-clear">✕</button>
      </div>

      <div class="filter-row" id="filter-row">
        <button type="button" class="pill active" data-f="all">Tất cả</button>
        <button type="button" class="pill" data-f="5g">5GHz</button>
        <button type="button" class="pill" data-f="2g">2.4GHz</button>
        <button type="button" class="pill" data-f="lan">LAN</button>
        <button type="button" class="pill" data-f="blocked">Đang chặn</button>
        <button type="button" class="pill" data-f="weak">Sóng yếu</button>
        <span class="sep"></span>
        <div id="group-pills" style="display:inline-flex;gap:5px"></div>
      </div>

      <div class="filter-row" id="sort-row">
        <span style="font-size:11.5px;color:var(--text-muted);font-weight:600">Sắp xếp:</span>
        <button type="button" class="pill active" data-s="default">Mặc định</button>
        <button type="button" class="pill" data-s="speed">Tốc độ</button>
        <button type="button" class="pill" data-s="name">Tên A-Z</button>
        <button type="button" class="pill" data-s="newest">Mới nhất</button>
      </div>
    </section>

    <!-- 4. DEVICE CARDS -->
    <main>
      <div class="device-grid" id="list"></div>
      <div id="empty" style="display:none;text-align:center;padding:40px 12px;color:var(--text-muted)">
        Không có thiết bị nào phù hợp.
      </div>
    </main>
  </div>

  <!-- Bulk Action Bar -->
  <div class="bulk-bar" id="bulk-bar">
    <span style="font-size:12.5px;font-weight:700" id="bulk-cnt">Đã chọn 0</span>
    <div class="bulk-btns">
      <button type="button" class="bulk-btn" id="bulk-block">Chặn</button>
      <button type="button" class="bulk-btn" id="bulk-unblock">Bỏ chặn</button>
      <button type="button" class="bulk-btn" id="bulk-kick">Kick</button>
      <button type="button" class="bulk-btn" id="bulk-exit">✕</button>
    </div>
  </div>

  <button type="button" class="fab-add" id="fab-add">+ Chặn MAC</button>

  <!-- Bottom Tabs -->
  <nav class="bottom-nav">
    <button type="button" class="nav-tab active" id="tab-clients">Kết nối (<span id="cnt-cli">0</span>)</button>
    <button type="button" class="nav-tab" id="tab-blacklist">Blacklist (<span id="cnt-blk">0</span>)</button>
  </nav>

  <!-- Modal / Bottom Sheet -->
  <div class="scrim" id="dlg-scrim" hidden>
    <div class="modal" id="dlg-box" role="dialog" aria-modal="true">
      <div class="m-title" id="dlg-title"></div>
      <div class="m-desc" id="dlg-desc"></div>
      <div id="dlg-body" style="display:none"></div>
      <div class="m-footer" id="dlg-footer">
        <button type="button" class="btn-act" id="dlg-cancel">Đóng</button>
        <button type="button" class="btn-act primary" id="dlg-ok">Xác nhận</button>
      </div>
    </div>
  </div>

  <div class="toast-wrap" id="toast-wrap"></div>

  <script>
    const DEMO_MODE = false;
    const API = '/cgi-bin/devmgr';
    const STORAGE_KEY = 'cr6608_std_prefs_v1';
    const KNOWN_KEY = 'cr6608_std_known_v1';
    const CACHE_KEY = 'cr6608_std_cache_v1';

    const ICONS = ['📱','💻','🖥️','📺','📟','🎮','💡','📷','🤖','🔊','⌚','🔌','🖨️','📡','🚗','🔒','❄️','🧹','📻','🚪','🛎️','🌐','📦','🏷️'];
    const DEFAULT_GROUPS = ['Gia đình', 'Khách', 'IoT'];

    const OUI_MAP = new Map([
      ['F0:99:BF','Apple'],['AC:BC:32','Apple'],['F4:F5:DB','Apple'],['DC:A9:04','Apple'],
      ['B4:FB:E4','Xiaomi'],['7C:49:EB','Xiaomi'],['64:90:C1','Xiaomi'],['28:6C:07','Xiaomi'],
      ['50:EC:50','Samsung'],['BC:24:11','Samsung'],['34:C9:F0','Samsung'],
      ['84:F3:EB','Espressif'],['EC:FA:BC','Espressif'],['A4:CF:12','Espressif'],
      ['D8:3A:DD','Raspberry Pi'],['B8:27:EB','Raspberry Pi'],['E4:5F:01','Raspberry Pi'],
      ['00:1A:7D','Sony'],['FC:0F:E6','Sony'],['70:66:55','TP-Link'],
      ['38:F8:89','Huawei'],['70:54:F5','Huawei']
    ]);

    const domRegistry = new Map();
    const speedHistory = new Map();

    const defaultPrefs = {
      theme: 'auto',
      pollMs: 5000,
      icons: {},
      pinned: [],
      groups: {},
      customGroups: []
    };

    const state = {
      prefs: loadPrefs(),
      devices: [],
      sys: null,
      tab: 'clients',
      filter: 'all',
      groupFilter: '',
      sort: 'default',
      query: '',
      writing: false,
      timer: null,
      backoff: 5000,
      errors: 0,
      known: null,
      sessionNew: new Set(),
      firstOrder: new Map(),
      selectMode: false,
      selected: new Set()
    };

    const $ = id => document.getElementById(id);

    function loadPrefs() {
      try {
        const raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        return {
          theme: raw.theme || 'auto',
          pollMs: typeof raw.pollMs === 'number' ? raw.pollMs : 5000,
          icons: raw.icons || {},
          pinned: Array.isArray(raw.pinned) ? raw.pinned : [],
          groups: raw.groups || {},
          customGroups: Array.isArray(raw.customGroups) ? raw.customGroups : []
        };
      } catch (e) {
        return { ...defaultPrefs };
      }
    }

    function savePrefs() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state.prefs));
    }

    function applyTheme() {
      const sysDark = matchMedia('(prefers-color-scheme: dark)').matches;
      const active = state.prefs.theme === 'auto' ? (sysDark ? 'dark' : 'light') : state.prefs.theme;
      document.documentElement.dataset.theme = active;
      const pSec = state.prefs.pollMs === 0 ? 'Tay' : (state.prefs.pollMs / 1000) + 's';
      $('btn-poll').textContent = `⏱ ${pSec}`;
    }

    function toast(msg) {
      const wrap = $('toast-wrap');
      const el = document.createElement('div');
      el.className = 'toast';
      el.textContent = msg;
      wrap.appendChild(el);
      setTimeout(() => el.remove(), 2400);
    }

    function copyText(txt, lbl) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(txt).then(() => toast(`Đã sao chép ${lbl}: ${txt}`));
      } else {
        const i = document.createElement('input');
        i.value = txt; document.body.appendChild(i); i.select();
        document.execCommand('copy'); i.remove();
        toast(`Đã sao chép ${lbl}: ${txt}`);
      }
    }

    function fmtSpeed(b) {
      if (!b || b <= 0) return '0 B/s';
      if (b < 1024) return b + ' B/s';
      if (b < 1048576) return (b / 1024).toFixed(1) + ' KB/s';
      return (b / 1048576).toFixed(2) + ' MB/s';
    }

    function fmtBytes(b) {
      if (!b || b <= 0) return '0 B';
      if (b < 1024) return b + ' B';
      if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
      if (b < 1073741824) return (b / 1048576).toFixed(2) + ' MB';
      return (b / 1073741824).toFixed(2) + ' GB';
    }

    function fmtUptime(sec) {
      if (!sec || sec <= 0) return '-';
      const d = Math.floor(sec / 86400);
      const h = Math.floor((sec % 86400) / 3600);
      const m = Math.floor((sec % 3600) / 60);
      return d > 0 ? `${d}d ${h}h` : `${h}h ${m}m`;
    }

    function fmtLastSeen(unixSec) {
      if (!unixSec || unixSec <= 0) return '';
      const diff = Math.max(1, Math.floor(Date.now() / 1000) - unixSec);
      if (diff < 60) return 'Thấy lần cuối vừa xong';
      if (diff < 3600) return `Thấy lần cuối ${Math.floor(diff / 60)} phút trước`;
      if (diff < 86400) return `Thấy lần cuối ${Math.floor(diff / 3600)} giờ trước`;
      return `Thấy lần cuối ${Math.floor(diff / 86400)} ngày trước`;
    }

    function fmtQos(kbps) {
      if (!kbps || kbps <= 0) return '';
      return kbps >= 1024 ? (kbps / 1024).toFixed(1).replace(/\.0$/, '') + ' MB/s' : kbps + ' KB/s';
    }

    function isRandomMac(mac) {
      const b = parseInt((mac || '').slice(0, 2), 16);
      return !isNaN(b) && Boolean(b & 0x02);
    }

    function isGarbageHostname(h) {
      if (!h) return true;
      const s = h.trim();
      return !s || s === '*' || s === '?' || s === 'localhost' || /^android-[0-9a-f]{6,}$/i.test(s);
    }

    function resolveProfile(d) {
      const mac = (d.mac || '').toUpperCase();
      const rand = isRandomMac(mac);
      const last4 = mac.replace(/[:-]/g, '').slice(-4);
      let vendor = rand ? '' : ((d.vendor || '').trim() || OUI_MAP.get(mac.slice(0, 8)) || '');

      let name = (d.name || '').trim();
      if (!name) {
        const host = isGarbageHostname(d.hostname) ? '' : d.hostname.trim();
        if (host) name = host;
        else if (vendor) name = `${vendor} · ${last4}`;
        else if (rand) name = `Thiết bị riêng tư · ${last4}`;
        else name = 'Không rõ';
      }

      let icon = state.prefs.icons[mac];
      if (!icon) {
        const hint = (name + ' ' + vendor).toLowerCase();
        if (d.band === 'LAN') icon = '🖥️';
        else if (/tv|tivi|bravia/.test(hint)) icon = '📺';
        else if (/esp|iot|cam|light|plug|vacuum/.test(hint)) icon = '💡';
        else if (/ipad|tab/.test(hint)) icon = '📟';
        else if (/macbook|laptop|pc|desktop|thinkpad/.test(hint)) icon = '💻';
        else icon = '📱';
      }
      return { name, vendor, icon, rand };
    }

    function buildSparkPoints(mac) {
      const arr = speedHistory.get(mac);
      if (!arr || arr.length < 2) return '';
      const max = Math.max(1024, ...arr);
      const w = 52, h = 20;
      const step = w / (arr.length - 1);
      return arr.map((v, i) => `${(i * step).toFixed(1)},${(h - (v / max) * (h - 2) - 1).toFixed(1)}`).join(' ');
    }

    function makeTag(text, cls) {
      const s = document.createElement('span');
      s.className = `tag ${cls}`;
      s.textContent = text;
      return s;
    }

    /* ==========================================================================
       DOM SYNC ENGINE
       ========================================================================== */
    function syncCard(container, d) {
      const mac = d.mac;
      const prof = resolveProfile(d);
      const offline = !d.online;
      const isNew = state.sessionNew.has(mac);
      const isPinned = state.prefs.pinned.includes(mac);
      const isSel = state.selected.has(mac);
      const grp = state.prefs.groups[mac] || '';

      let rssiLvl = 0;
      if (d.band !== 'LAN' && typeof d.signal === 'number' && d.signal < 0) {
        rssiLvl = d.signal >= -55 ? 4 : d.signal >= -67 ? 3 : d.signal >= -78 ? 2 : 1;
      }

      let ref = domRegistry.get(mac);
      if (!ref) {
        const el = document.createElement('div');
        el.className = 'card';
        el.dataset.mac = mac;
        el.innerHTML = `
          <div class="c-row1">
            <div class="c-id">
              <div class="chk-sel">✓</div>
              <button type="button" class="ico-btn" title="Đổi biểu tượng">
                <span class="v-ico"></span>
                <span class="pin-badge">📌</span>
              </button>
              <div class="c-names">
                <div class="c-title-wrap">
                  <span class="c-name v-name"></span>
                  <button type="button" class="btn-rename" title="Đổi tên">✎</button>
                </div>
                <div class="c-sub">
                  <span class="v-sub"></span>
                  <span class="rssi v-rssi"><i></i><i></i><i></i><i></i></span>
                </div>
              </div>
            </div>
            <div class="sw-box">
              <label class="sw"><input type="checkbox" class="v-chk"><span class="sw-slider"></span></label>
              <span class="sw-lbl">CHẶN</span>
            </div>
          </div>
          <div class="c-tags v-tags"></div>
          <div class="c-net">
            <div class="net-addrs">
              <button type="button" class="copy-link c-ip"><span>IP: </span><b class="v-ip"></b></button>
              <button type="button" class="copy-link c-mac"><span>MAC: </span><b class="v-mac"></b></button>
            </div>
            <div class="net-spd">
              <div class="spd-col">
                <span class="spd-rx">↓ <span class="v-rx"></span></span>
                <span class="spd-tx">↑ <span class="v-tx"></span></span>
              </div>
              <svg class="spark" viewBox="0 0 52 22"><polyline class="v-spark" points=""></polyline></svg>
            </div>
          </div>
          <div class="c-acts">
            <div class="act-left">
              <button type="button" class="btn-act primary b-qos">QoS</button>
              <button type="button" class="btn-act b-static">Gán IP</button>
              <button type="button" class="btn-act b-wol">WOL</button>
              <button type="button" class="btn-act b-kick">Kick</button>
            </div>
            <button type="button" class="btn-act danger b-bl">Blacklist</button>
          </div>
        `;

        ref = {
          el,
          ico: el.querySelector('.v-ico'),
          name: el.querySelector('.v-name'),
          sub: el.querySelector('.v-sub'),
          rssi: el.querySelector('.v-rssi'),
          tags: el.querySelector('.v-tags'),
          chk: el.querySelector('.v-chk'),
          ip: el.querySelector('.v-ip'),
          mac: el.querySelector('.v-mac'),
          spark: el.querySelector('.v-spark'),
          rx: el.querySelector('.v-rx'),
          tx: el.querySelector('.v-tx'),
          stat: el.querySelector('.b-static'),
          kick: el.querySelector('.b-kick'),
          bl: el.querySelector('.b-bl'),
          cache: {}
        };

        el.querySelector('.ico-btn').onclick = e => { e.stopPropagation(); openIconPicker(el._d.mac, ref.cache.ico); };
        el.querySelector('.btn-rename').onclick = e => { e.stopPropagation(); openRename(el._d); };
        el.querySelector('.c-ip').onclick = e => { e.stopPropagation(); if (el._d.ip) copyText(el._d.ip, 'IP'); };
        el.querySelector('.c-mac').onclick = e => { e.stopPropagation(); copyText(el._d.mac, 'MAC'); };

        el.querySelector('.sw-box').onclick = e => e.stopPropagation();
        ref.chk.onchange = e => {
          const cur = el._d;
          postAction({ action: e.target.checked ? 'block' : 'unblock', mac: cur.mac })
            .then(ok => { if (!ok) e.target.checked = !e.target.checked; else fetchList(); });
        };

        el.querySelector('.b-qos').onclick = e => { e.stopPropagation(); openQosModal(el._d); };
        ref.stat.onclick = e => {
          e.stopPropagation();
          const cur = el._d;
          if (!cur.ip) return;
          openConfirm('Cố định IP', `Gán cứng IP ${cur.ip} cho "${resolveProfile(cur).name}"?`, () =>
            postAction({ action: 'static_lease', mac: cur.mac, ip: cur.ip })
          );
        };
        el.querySelector('.b-wol').onclick = e => {
          e.stopPropagation();
          const cur = el._d;
          openConfirm('Wake-on-LAN', `Gửi gói đánh thức tới [${cur.mac}]?`, () =>
            postAction({ action: 'wol', mac: cur.mac })
          );
        };
        ref.kick.onclick = e => {
          e.stopPropagation();
          const cur = el._d;
          openConfirm('Kick khỏi Wi-Fi', `Ngắt kết nối ngay của "${resolveProfile(cur).name}"?`, () =>
            postAction({ action: 'kick', mac: cur.mac }).then(ok => ok && fetchList())
          );
        };
        ref.bl.onclick = e => {
          e.stopPropagation();
          const cur = el._d;
          const isBl = Boolean(cur.blacklisted);
          openConfirm(isBl ? 'Bỏ Blacklist' : 'Thêm Blacklist', `${isBl ? 'Cho phép' : 'Cấm vĩnh viễn'} "${resolveProfile(cur).name}"?`, () =>
            postAction({ action: isBl ? 'blacklist_remove' : 'blacklist_add', mac: cur.mac }).then(ok => ok && fetchList())
          );
        };

        // Long press -> Multi-select | Tap -> Detail Drawer
        let lpTimer = null, lpFired = false;
        el.addEventListener('pointerdown', e => {
          if (e.target.closest('button, label, input')) return;
          lpFired = false;
          lpTimer = setTimeout(() => { lpFired = true; enterSelectMode(el._d.mac); }, 450);
        });
        const stopLp = () => { if (lpTimer) { clearTimeout(lpTimer); lpTimer = null; } };
        el.addEventListener('pointerup', stopLp);
        el.addEventListener('pointerleave', stopLp);
        el.addEventListener('pointercancel', stopLp);

        el.onclick = () => {
          if (lpFired) return;
          if (state.selectMode) toggleSelect(el._d.mac);
          else openDetailSheet(el._d);
        };

        domRegistry.set(mac, ref);
        container.appendChild(el);
      }

      ref.el._d = d;
      const c = ref.cache;

      if (c.offline !== offline) { ref.el.classList.toggle('offline', offline); c.offline = offline; }
      if (c.pinned !== isPinned) { ref.el.classList.toggle('pinned', isPinned); c.pinned = isPinned; }
      if (c.sel !== isSel) { ref.el.classList.toggle('selected', isSel); c.sel = isSel; }
      if (c.ico !== prof.icon) { ref.ico.textContent = prof.icon; c.ico = prof.icon; }
      if (c.name !== prof.name) { ref.name.textContent = prof.name; c.name = prof.name; }

      const statusTxt = d.online ? 'Online' : (fmtLastSeen(d.last_seen) || 'Offline');
      const subTxt = `${prof.vendor ? prof.vendor + ' · ' : ''}${statusTxt}`;
      if (c.subTxt !== subTxt) { ref.sub.textContent = subTxt; c.subTxt = subTxt; }

      if (c.rssiLvl !== rssiLvl) {
        if (rssiLvl > 0) {
          ref.rssi.style.display = 'inline-flex';
          ref.rssi.dataset.l = String(rssiLvl);
          ref.rssi.title = `${d.signal} dBm`;
        } else {
          ref.rssi.style.display = 'none';
        }
        c.rssiLvl = rssiLvl;
      }

      const qosTxt = fmtQos(Number(d.qos_rate || 0));
      const tagKey = `${isNew}|${prof.rand}|${d.band}|${grp}|${d.blocked}|${qosTxt}`;
      if (c.tagKey !== tagKey) {
        ref.tags.textContent = '';
        if (isNew) ref.tags.appendChild(makeTag('MỚI', 'new'));
        if (d.band) ref.tags.appendChild(makeTag(d.band, ''));
        if (grp) ref.tags.appendChild(makeTag(grp, 'grp'));
        if (prof.rand) ref.tags.appendChild(makeTag('MAC riêng tư', ''));
        if (qosTxt) ref.tags.appendChild(makeTag(`Max ${qosTxt}`, 'qos'));
        if (d.blocked) ref.tags.appendChild(makeTag('Đang chặn', 'blk'));
        ref.tags.style.display = ref.tags.children.length ? 'flex' : 'none';
        c.tagKey = tagKey;
      }

      const blk = Boolean(d.blocked);
      if (c.blk !== blk) { ref.chk.checked = blk; c.blk = blk; }

      const ipStr = d.ip || 'Chưa cấp';
      if (c.ipStr !== ipStr) { ref.ip.textContent = ipStr; c.ipStr = ipStr; }
      if (c.mac !== mac) { ref.mac.textContent = mac; c.mac = mac; }

      const pts = buildSparkPoints(mac);
      if (c.pts !== pts) { ref.spark.setAttribute('points', pts); c.pts = pts; }

      const rxStr = fmtSpeed(d.rx);
      if (c.rxStr !== rxStr) { ref.rx.textContent = rxStr; c.rxStr = rxStr; }
      const txStr = fmtSpeed(d.tx);
      if (c.txStr !== txStr) { ref.tx.textContent = txStr; c.txStr = txStr; }

      const canStatic = Boolean(d.ip && !d.blacklisted);
      if (c.canStatic !== canStatic) { ref.stat.style.display = canStatic ? 'inline-block' : 'none'; c.canStatic = canStatic; }

      const canKick = Boolean(d.online && d.band !== 'LAN' && !d.blacklisted);
      if (c.canKick !== canKick) { ref.kick.style.display = canKick ? 'inline-block' : 'none'; c.canKick = canKick; }

      const isBl = Boolean(d.blacklisted);
      if (c.bl !== isBl) { ref.bl.textContent = isBl ? 'Bỏ Blacklist' : 'Blacklist'; c.bl = isBl; }
    }

    /* ==========================================================================
       MULTI-SELECT
       ========================================================================== */
    function enterSelectMode(mac) {
      state.selectMode = true;
      state.selected.clear();
      if (mac) state.selected.add(mac);
      document.body.classList.add('select-mode');
      updateBulkBar();
      render();
    }

    function exitSelectMode() {
      state.selectMode = false;
      state.selected.clear();
      document.body.classList.remove('select-mode');
      $('bulk-bar').classList.remove('show');
      render();
    }

    function toggleSelect(mac) {
      if (state.selected.has(mac)) state.selected.delete(mac);
      else state.selected.add(mac);
      if (state.selected.size === 0) exitSelectMode();
      else { updateBulkBar(); render(); }
    }

    function updateBulkBar() {
      const bar = $('bulk-bar');
      if (state.selectMode && state.selected.size > 0) {
        bar.classList.add('show');
        $('bulk-cnt').textContent = `Đã chọn ${state.selected.size}`;
      } else {
        bar.classList.remove('show');
      }
    }

    async function runBulkAction(action) {
      const macs = [...state.selected];
      if (!macs.length) return;
      exitSelectMode();
      toast(`Đang gửi lệnh tới ${macs.length} thiết bị...`);
      for (const mac of macs) {
        const dev = state.devices.find(x => x.mac === mac);
        if (!dev) continue;
        if (action === 'kick' && (!dev.online || dev.band === 'LAN')) continue;
        await postAction({ action, mac }, true);
      }
      toast('Hoàn tất thao tác hàng loạt');
      fetchList();
    }

    /* ==========================================================================
       RENDER PIPELINE
       ========================================================================== */
    function renderGroupPills() {
      const wrap = $('group-pills');
      const allGroups = [...new Set([...DEFAULT_GROUPS, ...state.prefs.customGroups])];
      wrap.textContent = '';
      allGroups.forEach(g => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `pill ${state.groupFilter === g ? 'active' : ''}`;
        b.textContent = g;
        b.onclick = () => {
          state.groupFilter = state.groupFilter === g ? '' : g;
          renderGroupPills();
          render();
        };
        wrap.appendChild(b);
      });
    }

    function renderSys() {
      const bar = $('sys-bar');
      if (!state.sys || typeof state.sys !== 'object') {
        bar.style.display = 'none';
        return;
      }
      bar.style.display = 'flex';
      const s = state.sys;
      $('sys-load').textContent = typeof s.load === 'number' ? s.load.toFixed(2) : '-';
      $('sys-mem').textContent = typeof s.mem_used_pct === 'number' ? `${s.mem_used_pct}%` : '-';
      $('sys-up').textContent = fmtUptime(s.uptime);
      $('sys-cli').textContent = typeof s.clients === 'number' ? String(s.clients) : '-';
    }

    function renderTop3(clients) {
      const bar = $('top3-bar');
      const listEl = $('top3-list');
      const top = clients
        .filter(d => d.online && ((d.rx || 0) + (d.tx || 0)) > 0)
        .sort((a, b) => ((b.rx || 0) + (b.tx || 0)) - ((a.rx || 0) + (a.tx || 0)))
        .slice(0, 3);

      if (!top.length) {
        bar.style.display = 'none';
        return;
      }
      bar.style.display = 'flex';
      listEl.textContent = '';
      top.forEach(d => {
        const p = resolveProfile(d);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'top3-tag';
        const b = document.createElement('b'); b.textContent = p.name;
        const sp = document.createElement('span'); sp.textContent = fmtSpeed((d.rx || 0) + (d.tx || 0));
        btn.append(document.createTextNode(p.icon + ' '), b, sp);
        btn.onclick = () => openDetailSheet(d);
        listEl.appendChild(btn);
      });
    }

    function render() {
      renderSys();
      const container = $('list');

      let list = state.devices.filter(d =>
        state.tab === 'blacklist' ? Boolean(d.blacklisted) : (!d.blacklisted && (d.online || d.blocked))
      );

      if (state.filter === '5g') list = list.filter(d => (d.band || '').includes('5G'));
      else if (state.filter === '2g') list = list.filter(d => (d.band || '').includes('2'));
      else if (state.filter === 'lan') list = list.filter(d => d.band === 'LAN');
      else if (state.filter === 'blocked') list = list.filter(d => d.blocked);
      else if (state.filter === 'weak') list = list.filter(d => d.online && d.band !== 'LAN' && d.signal && d.signal < -72);

      if (state.groupFilter) {
        list = list.filter(d => (state.prefs.groups[d.mac] || '') === state.groupFilter);
      }

      if (state.query) {
        const q = state.query;
        list = list.filter(d => {
          const p = resolveProfile(d);
          const g = (state.prefs.groups[d.mac] || '').toLowerCase();
          return d.mac.toLowerCase().includes(q) || (d.ip && d.ip.includes(q)) ||
                 p.name.toLowerCase().includes(q) || p.vendor.toLowerCase().includes(q) || g.includes(q);
        });
      }

      const pinSet = new Set(state.prefs.pinned);
      list.sort((a, b) => {
        const pa = pinSet.has(a.mac) ? 1 : 0;
        const pb = pinSet.has(b.mac) ? 1 : 0;
        if (pa !== pb) return pb - pa;

        if (state.sort === 'speed') return ((b.rx || 0) + (b.tx || 0)) - ((a.rx || 0) + (a.tx || 0));
        if (state.sort === 'name') return resolveProfile(a).name.localeCompare(resolveProfile(b).name, 'vi');
        if (state.sort === 'newest') {
          const na = state.sessionNew.has(a.mac) ? 1 : 0;
          const nb = state.sessionNew.has(b.mac) ? 1 : 0;
          if (na !== nb) return nb - na;
          return (state.firstOrder.get(b.mac) || 0) - (state.firstOrder.get(a.mac) || 0);
        }
        return (state.firstOrder.get(a.mac) || 0) - (state.firstOrder.get(b.mac) || 0);
      });

      const activeSet = new Set(list.map(d => d.mac));
      for (const [mac, ref] of domRegistry.entries()) {
        if (!activeSet.has(mac)) {
          ref.el.remove();
          domRegistry.delete(mac);
        }
      }

      list.forEach((d, idx) => {
        syncCard(container, d);
        const ref = domRegistry.get(d.mac);
        if (ref && container.children[idx] !== ref.el) {
          container.insertBefore(ref.el, container.children[idx] || null);
        }
      });

      $('empty').style.display = list.length === 0 ? 'block' : 'none';

      const clients = state.devices.filter(d => !d.blacklisted && (d.online || d.blocked));
      let onlineCnt = 0, rxSum = 0, txSum = 0;
      for (const c of clients) {
        if (c.online) {
          onlineCnt++;
          rxSum += (c.rx || 0);
          txSum += (c.tx || 0);
        }
      }
      $('cnt-cli').textContent = clients.length;
      $('cnt-blk').textContent = state.devices.filter(d => d.blacklisted).length;
      $('tot-cnt').textContent = `${onlineCnt} / ${clients.length}`;
      $('tot-rx').textContent = fmtSpeed(rxSum);
      $('tot-tx').textContent = fmtSpeed(txSum);
      renderTop3(clients);
    }

    /* ==========================================================================
       API COMMUNICATION
       ========================================================================== */
    async function postAction(payload, silent = false) {
      if (state.writing) {
        if (!silent) toast('Đang xử lý lệnh trước, vui lòng đợi...');
        return false;
      }
      state.writing = true;
      const ctrl = new AbortController();
      const tid = setTimeout(() => ctrl.abort(), 4000);

      try {
        if (DEMO_MODE) {
          await new Promise(r => setTimeout(r, 180));
          if (payload.action === 'reboot') {
            clearTimeout(tid); if (!silent) toast('Demo: Đã gửi lệnh khởi động lại'); return true;
          }
          const dev = state.devices.find(x => x.mac === payload.mac);
          if (dev) {
            if (payload.action === 'block') dev.blocked = true;
            if (payload.action === 'unblock') dev.blocked = false;
            if (payload.action === 'rename') dev.name = payload.name;
            if (payload.action === 'qos_limit') dev.qos_rate = payload.rate;
            if (payload.action === 'blacklist_add') dev.blacklisted = true;
            if (payload.action === 'blacklist_remove') dev.blacklisted = false;
            if (payload.action === 'kick') dev.online = false;
          } else if (payload.action === 'blacklist_add') {
            state.devices.push({ mac: payload.mac, ip: '', hostname: '', name: '', vendor: '', iface: 'phy1-ap0', band: '5G', signal: 0, rx: 0, tx: 0, qos_rate: 0, online: false, blocked: false, blacklisted: true });
          }
          clearTimeout(tid);
          if (!silent) toast('Demo: Thành công');
          render();
          return true;
        }

        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          signal: ctrl.signal
        });
        clearTimeout(tid);
        const data = await res.json();
        if (data && data.ok) {
          if (!silent) toast('Thành công');
          return true;
        }
        if (!silent) toast((data && data.error) || 'Router từ chối thao tác');
        return false;
      } catch (e) {
        clearTimeout(tid);
        if (!silent) toast(e.name === 'AbortError' ? 'Quá thời gian (4s)' : 'Lỗi kết nối Router');
        return false;
      } finally {
        state.writing = false;
      }
    }

    function processIncomingDevices(devices) {
      if (state.known === null) {
        const stored = localStorage.getItem(KNOWN_KEY);
        if (stored === null) {
          state.known = new Set(devices.map(d => d.mac));
          localStorage.setItem(KNOWN_KEY, JSON.stringify([...state.known]));
        } else {
          try { state.known = new Set(JSON.parse(stored)); } catch (e) { state.known = new Set(); }
        }
      }

      let knownChanged = false;
      devices.forEach(d => {
        if (!d.mac) return;
        if (!state.firstOrder.has(d.mac)) {
          state.firstOrder.set(d.mac, state.firstOrder.size);
        }
        if (!state.known.has(d.mac)) {
          state.sessionNew.add(d.mac);
          state.known.add(d.mac);
          knownChanged = true;
        }
        const hist = speedHistory.get(d.mac) || [];
        hist.push(d.online ? ((d.rx || 0) + (d.tx || 0)) : 0);
        if (hist.length > 30) hist.shift();
        speedHistory.set(d.mac, hist);
      });

      if (knownChanged) {
        localStorage.setItem(KNOWN_KEY, JSON.stringify([...state.known]));
      }
    }

    function scheduleNextPoll() {
      if (state.timer) { clearTimeout(state.timer); state.timer = null; }
      if (document.visibilityState !== 'visible') return;
      if (state.prefs.pollMs === 0 && state.errors === 0) return;
      const wait = state.errors > 0 ? state.backoff : state.prefs.pollMs;
      if (wait > 0) state.timer = setTimeout(fetchList, wait);
    }

    async function fetchList() {
      if (state.timer) { clearTimeout(state.timer); state.timer = null; }
      const badge = $('sync-badge');
      badge.className = 'status-dot syncing';
      badge.textContent = '↻ Đang tải';

      if (DEMO_MODE) {
        if (!state.devices.length) {
          const now = Math.floor(Date.now() / 1000);
          state.sys = { load: 0.32, mem_used_pct: 40, uptime: 174200, clients: 4 };
          state.devices = [
            { mac: 'F0:99:BF:11:22:33', ip: '192.168.2.10', hostname: 'iPhone-Pro', name: '', vendor: 'Apple', iface: 'phy1-ap0', band: '5G', signal: -48, rx: 1450000, tx: 230000, qos_rate: 0, online: true, blocked: false, blacklisted: false, day_rx: 2450000000, day_tx: 320000000 },
            { mac: 'B4:FB:E4:44:55:66', ip: '192.168.2.15', hostname: 'Mi-TV', name: 'TV Phòng Khách', vendor: 'Xiaomi', iface: 'phy1-ap0', band: '5G', signal: -63, rx: 3850000, tx: 92000, qos_rate: 5120, online: true, blocked: false, blacklisted: false, day_rx: 8920000000, day_tx: 110000000 },
            { mac: 'D8:3A:DD:77:88:99', ip: '192.168.2.20', hostname: 'raspberrypi', name: '', vendor: 'Raspberry Pi', iface: 'eth0.1', band: 'LAN', signal: 0, rx: 64000, tx: 21000, qos_rate: 0, online: true, blocked: false, blacklisted: false, day_rx: 512000000, day_tx: 480000000 },
            { mac: '3E:A1:90:AA:BB:CC', ip: '192.168.2.35', hostname: 'android-8f92a1bc', name: '', vendor: 'ShouldIgnore', iface: 'phy0-ap0', band: '2.4G', signal: -79, rx: 0, tx: 0, qos_rate: 0, online: false, blocked: true, blacklisted: false, last_seen: now - 7200, day_rx: 120000000, day_tx: 15000000 }
          ];
        } else {
          state.devices.forEach(d => {
            if (d.online) {
              d.rx = Math.max(0, Math.round(d.rx * (0.75 + Math.random() * 0.5)));
              d.tx = Math.max(0, Math.round(d.tx * (0.75 + Math.random() * 0.5)));
            }
          });
        }
        processIncomingDevices(state.devices);
        badge.className = 'status-dot';
        badge.textContent = '● Demo';
        $('err-box').style.display = 'none';
        render();
        scheduleNextPoll();
        return;
      }

      const ctrl = new AbortController();
      const tid = setTimeout(() => ctrl.abort(), 4000);

      try {
        const res = await fetch(`${API}?action=list`, { signal: ctrl.signal, cache: 'no-store' });
        clearTimeout(tid);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const json = await res.json();
        state.sys = json.sys || null;
        state.devices = Array.isArray(json.devices) ? json.devices : [];
        processIncomingDevices(state.devices);

        try { localStorage.setItem(CACHE_KEY, JSON.stringify({ sys: state.sys, devices: state.devices })); } catch (e) {}

        state.errors = 0;
        state.backoff = 5000;
        badge.className = 'status-dot';
        badge.textContent = '● Online';
        $('err-box').style.display = 'none';
        render();
      } catch (e) {
        clearTimeout(tid);
        state.errors++;
        state.backoff = state.errors === 1 ? 5000 : state.errors === 2 ? 10000 : 30000;
        badge.className = 'status-dot err';
        badge.textContent = '▲ Mất kết nối';
        $('err-msg').textContent = `Lỗi kết nối Router (tự thử lại sau ${state.backoff / 1000}s).`;
        $('err-box').style.display = 'flex';
      } finally {
        scheduleNextPoll();
      }
    }

