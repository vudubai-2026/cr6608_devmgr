    .t-up { color: var(--md-sys-color-success); }
    .sparkline { width: 56px; height: 24px; display: block; overflow: visible; }
    .sparkline-stroke { fill: none; stroke: var(--md-sys-color-primary); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

    /* Card Action Row (Outlined & Tonal Buttons) */
    .card-actions { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .action-cluster { display: flex; gap: 6px; flex-wrap: wrap; }
    .btn-m3-sm {
      height: 32px; padding: 0 10px;
      border-radius: var(--md-sys-shape-corner-small);
