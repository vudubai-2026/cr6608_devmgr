      const okBtn = $('dlg-ok');
      okBtn.style.display = showOk ? 'inline-block' : 'none';
      okBtn.textContent = okText;
      okBtn.className = `btn-act ${okClass}`;
      dlgCb = onOk || null;

      scrim.hidden = false;
    }

