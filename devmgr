    .icon-picker-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; max-height: 220px; overflow-y: auto; margin-bottom: 12px; }
    .icon-choice {
      height: 46px; border-radius: var(--md-sys-shape-corner-medium);
      border: 1px solid var(--md-sys-color-outline-variant);
      background: var(--md-sys-color-surface-container-lowest);
      font-size: 1.4rem; cursor: pointer;
    }
    .icon-choice[aria-selected="true"] {
      background: var(--md-sys-color-primary-container);
      border-color: var(--md-sys-color-primary);
      border-width: 2px;
    }

    /* M3 Snackbar (InverseSurface + InverseOnSurface) */
    .snackbar-region {
      position: fixed; bottom: calc(92px + env(safe-area-inset-bottom)); left: 16px; right: 16px;
      display: flex; flex-direction: column; align-items: center; gap: 8px;
      z-index: 120; pointer-events: none;
