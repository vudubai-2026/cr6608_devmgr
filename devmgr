      box-shadow: var(--md-sys-elevation-level3);
    }
    [data-theme="dark"] .m3-snackbar { background: #E2E2E9; color: #191C20; }
  </style>
</head>
<body>

  <div class="app-shell">
    <!-- Adaptive Navigation: Bottom Bar (Compact) / Navigation Rail (Expanded >= 840px) -->
    <nav class="nav-container" aria-label="Điều hướng chính">
      <button type="button" class="nav-destination" id="tab-clients" aria-selected="true">
