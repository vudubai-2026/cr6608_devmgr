<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#F8FAFD" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#111318" media="(prefers-color-scheme: dark)">
  <title>Xiaomi CR6608 · Quản lý thiết bị</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

    /* ==========================================================================
       1. MATERIAL DESIGN 3 SEMANTIC TOKENS (Tonal Surface Ladder + Roles)
       ========================================================================== */
    :root {
      --md-sys-typescale-font: -apple-system, BlinkMacSystemFont, "Google Sans", "Segoe UI", Roboto, sans-serif;
      --md-sys-typescale-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

      /* Shape Scale */
      --md-sys-shape-corner-extra-small: 4px;
      --md-sys-shape-corner-small: 8px;
      --md-sys-shape-corner-medium: 12px;
      --md-sys-shape-corner-large: 16px;
      --md-sys-shape-corner-extra-large: 28px;
      --md-sys-shape-corner-full: 9999px;

      /* Motion Easing */
      --md-sys-motion-easing-standard: cubic-bezier(0.2, 0.0, 0.0, 1.0);
      --md-sys-motion-easing-emphasized-decelerate: cubic-bezier(0.05, 0.7, 0.1, 1.0);

      /* Light Color Scheme (M3 Baseline Blue/Slate) */
      --md-sys-color-primary: #0B57D0;
      --md-sys-color-on-primary: #FFFFFF;
      --md-sys-color-primary-container: #D3E3FD;
      --md-sys-color-on-primary-container: #041E49;

      --md-sys-color-secondary: #4A607A;
      --md-sys-color-on-secondary: #FFFFFF;
      --md-sys-color-secondary-container: #D2E4FF;
      --md-sys-color-on-secondary-container: #051D33;

      --md-sys-color-tertiary-container: #EADDFF;
      --md-sys-color-on-tertiary-container: #21005D;

      --md-sys-color-error: #B3261E;
      --md-sys-color-on-error: #FFFFFF;
      --md-sys-color-error-container: #F9DEDC;
      --md-sys-color-on-error-container: #410E0B;

      --md-sys-color-warning-container: #FFE082;
      --md-sys-color-on-warning-container: #261900;
      --md-sys-color-success: #146C2E;
      --md-sys-color-success-container: #C4EED0;
      --md-sys-color-on-success-container: #072711;

      /* Surface Container Ladder (Replaces heavy shadows in M3) */
      --md-sys-color-surface: #F8FAFD;
      --md-sys-color-on-surface: #191C20;
      --md-sys-color-on-surface-variant: #43474E;
      --md-sys-color-outline: #73777F;
      --md-sys-color-outline-variant: #C3C7D0;

      --md-sys-color-surface-container-lowest: #FFFFFF;
      --md-sys-color-surface-container-low: #F2F4F9;
      --md-sys-color-surface-container: #ECEEF4;
      --md-sys-color-surface-container-high: #E6E8EE;
      --md-sys-color-surface-container-highest: #E0E2E8;

      --md-sys-color-scrim: rgba(0, 0, 0, 0.36);
      --md-sys-state-hover-opacity: 0.08;
      --md-sys-state-pressed-opacity: 0.12;
      --md-sys-elevation-level1: 0 1px 2px rgba(0,0,0,0.06), 0 1px 3px 1px rgba(0,0,0,0.04);
      --md-sys-elevation-level3: 0 4px 8px 3px rgba(0,0,0,0.10), 0 1px 3px rgba(0,0,0,0.18);
    }

    [data-theme="dark"] {
      --md-sys-color-primary: #A8C7FA;
      --md-sys-color-on-primary: #062E6F;
      --md-sys-color-primary-container: #0842A0;
      --md-sys-color-on-primary-container: #D3E3FD;

      --md-sys-color-secondary: #B2C8E6;
      --md-sys-color-on-secondary: #1B3249;
      --md-sys-color-secondary-container: #324861;
      --md-sys-color-on-secondary-container: #D2E4FF;

      --md-sys-color-tertiary-container: #4F378B;
      --md-sys-color-on-tertiary-container: #EADDFF;

      --md-sys-color-error: #F2B8B5;
      --md-sys-color-on-error: #601410;
      --md-sys-color-error-container: #8C1D18;
      --md-sys-color-on-error-container: #F9DEDC;

      --md-sys-color-warning-container: #564500;
      --md-sys-color-on-warning-container: #FFE082;
      --md-sys-color-success: #6DD58C;
      --md-sys-color-success-container: #0F5223;
      --md-sys-color-on-success-container: #C4EED0;

      --md-sys-color-surface: #111318;
      --md-sys-color-on-surface: #E2E2E9;
      --md-sys-color-on-surface-variant: #C3C7D0;
      --md-sys-color-outline: #8D9199;
      --md-sys-color-outline-variant: #43474E;

      --md-sys-color-surface-container-lowest: #0C0E13;
      --md-sys-color-surface-container-low: #191C20;
      --md-sys-color-surface-container: #1D2024;
      --md-sys-color-surface-container-high: #282A2F;
      --md-sys-color-surface-container-highest: #33353A;

      --md-sys-color-scrim: rgba(0, 0, 0, 0.56);
      --md-sys-elevation-level1: 0 1px 3px 1px rgba(0,0,0,0.3);
      --md-sys-elevation-level3: 0 4px 12px 4px rgba(0,0,0,0.45);
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Accessible Focus Ring */
    :focus-visible {
      outline: 3px solid var(--md-sys-color-primary);
      outline-offset: 2px;
    }

    html { background: var(--md-sys-color-surface); min-height: 100%; }
    body {
      font-family: var(--md-sys-typescale-font);
      background: var(--md-sys-color-surface);
      color: var(--md-sys-color-on-surface);
      line-height: 1.45;
      padding-bottom: calc(88px + env(safe-area-inset-bottom));
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Adaptive Window Layout: Compact Mobile -> Expanded Split Pane */
    .app-shell {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 16px;
    }
    @media (min-width: 840px) {
      body { padding-bottom: 32px; }
      .app-shell {
        display: grid;
        grid-template-columns: 88px 1fr;
        gap: 20px;
        padding: 0 24px;
      }
    }

    /* ==========================================================================
       2. ADAPTIVE NAVIGATION (Bottom Navigation Bar -> Navigation Rail)
       ========================================================================== */
    .nav-container {
      position: fixed; bottom: 0; left: 0; right: 0;
      height: calc(76px + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--md-sys-color-surface-container);
      border-top: 1px solid var(--md-sys-color-outline-variant);
      display: flex; justify-content: space-around; align-items: center;
      z-index: 50;
    }
    @media (min-width: 840px) {
      .nav-container {
        position: sticky; top: 0; height: 100vh; width: 88px;
        flex-direction: column; justify-content: flex-start;
        padding: 20px 0; gap: 16px;
        background: var(--md-sys-color-surface);
        border-top: none; border-right: 1px solid var(--md-sys-color-outline-variant);
      }
    }

    .nav-destination {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 4px; min-width: 72px; min-height: 56px;
      background: transparent; border: none; cursor: pointer;
      color: var(--md-sys-color-on-surface-variant);
    }
    .nav-pill {
      width: 64px; height: 32px; border-radius: var(--md-sys-shape-corner-full);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.15rem; transition: background 0.15s var(--md-sys-motion-easing-standard);
    }
    .nav-destination:hover .nav-pill { background: var(--md-sys-color-surface-container-highest); }
    .nav-destination[aria-selected="true"] .nav-pill {
      background: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
    }
    .nav-label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.02em; }
    .nav-destination[aria-selected="true"] .nav-label {
      color: var(--md-sys-color-on-surface);
      font-weight: 700;
    }

    /* ==========================================================================
       3. M3 TOP APP BAR (Small / Medium Contextual)
       ========================================================================== */
    .top-app-bar {
      position: sticky; top: 0; z-index: 40;
      background: var(--md-sys-color-surface);
      padding: 12px 0;
      display: flex; justify-content: space-between; align-items: center; gap: 12px;
    }
    .headline-wrap { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .router-badge {
      width: 40px; height: 40px; border-radius: var(--md-sys-shape-corner-medium);
      background: var(--md-sys-color-primary-container);
      color: var(--md-sys-color-on-primary-container);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem; flex-shrink: 0;
    }
    .headline-text { display: flex; flex-direction: column; min-width: 0; }
    .headline-title {
      font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em;
      display: flex; align-items: center; gap: 8px;
    }
    .headline-sub { font-size: 0.75rem; color: var(--md-sys-color-on-surface-variant); font-weight: 500; }

    .conn-indicator {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 0.68rem; font-weight: 700; padding: 2px 8px;
      border-radius: var(--md-sys-shape-corner-full);
      background: var(--md-sys-color-success-container);
      color: var(--md-sys-color-on-success-container);
    }
    .conn-indicator.syncing {
      background: var(--md-sys-color-primary-container);
      color: var(--md-sys-color-on-primary-container);
    }
    .conn-indicator.err {
      background: var(--md-sys-color-error-container);
      color: var(--md-sys-color-on-error-container);
    }

    .app-bar-actions { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
    /* M3 Standard Icon Button (48x48 accessible touch target) */
    .icon-btn-m3 {
      width: 44px; height: 44px; border-radius: var(--md-sys-shape-corner-full);
      border: none; background: transparent; color: var(--md-sys-color-on-surface-variant);
      display: inline-flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 1.15rem;
    }
    .icon-btn-m3:hover { background: var(--md-sys-color-surface-container-high); }
    .icon-btn-m3:active { background: var(--md-sys-color-surface-container-highest); transform: scale(0.94); }

    /* M3 Filled Tonal Button (Compact) */
    .tonal-btn-m3 {
      height: 40px; padding: 0 14px; border-radius: var(--md-sys-shape-corner-full);
      border: none; background: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
      display: inline-flex; align-items: center; gap: 6px;
      cursor: pointer; font-size: 0.78rem; font-weight: 700;
    }
    .tonal-btn-m3:active { opacity: 0.88; transform: scale(0.96); }

    /* ==========================================================================
       4. SUMMARY CONTAINER (Tonal Containment + Telemetry)
       ========================================================================== */
    .summary-section {
      background: var(--md-sys-color-surface-container-low);
      border-radius: var(--md-sys-shape-corner-large);
      padding: 14px;
      margin-bottom: 14px;
      display: flex; flex-direction: column; gap: 12px;
    }
    .kpi-row {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
    }
    .kpi-item {
      background: var(--md-sys-color-surface-container-lowest);
      border-radius: var(--md-sys-shape-corner-medium);
      padding: 10px 12px;
      display: flex; flex-direction: column; gap: 2px;
    }
    .kpi-label {
      font-size: 0.68rem; font-weight: 700; color: var(--md-sys-color-on-surface-variant);
      display: flex; align-items: center; gap: 5px;
    }
    .kpi-value {
      font-family: var(--md-sys-typescale-mono);
      font-size: 0.96rem; font-weight: 800; color: var(--md-sys-color-on-surface);
    }

    /* Collapsible Router System Status */
    .sys-disclosure {
      background: var(--md-sys-color-surface-container-lowest);
      border-radius: var(--md-sys-shape-corner-medium);
      overflow: hidden;
    }
    .sys-trigger {
      width: 100%; border: none; background: transparent;
      padding: 10px 12px; min-height: 40px;
      display: flex; justify-content: space-between; align-items: center;
      cursor: pointer; font-size: 0.78rem; font-weight: 700;
      color: var(--md-sys-color-on-surface-variant);
    }
    .sys-trigger:hover { background: var(--md-sys-color-surface-container); }
    .sys-metrics {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;
      padding: 10px 12px; border-top: 1px solid var(--md-sys-color-outline-variant);
    }
    .sys-disclosure[data-open="false"] .sys-metrics { display: none; }
    .sys-stat { display: flex; flex-direction: column; }
    .sys-stat-k { font-size: 0.64rem; font-weight: 600; color: var(--md-sys-color-on-surface-variant); }
    .sys-stat-v { font-family: var(--md-sys-typescale-mono); font-size: 0.84rem; font-weight: 700; }

    /* Top 3 Consumers Strip */
    .top3-strip {
      display: flex; align-items: center; gap: 8px; overflow-x: auto; scrollbar-width: none;
    }
    .top3-strip::-webkit-scrollbar { display: none; }
    .top3-caption { font-size: 0.74rem; font-weight: 700; color: var(--md-sys-color-on-surface-variant); white-space: nowrap; }
    .top3-item {
      height: 32px; padding: 0 12px; border-radius: var(--md-sys-shape-corner-full);
      border: 1px solid var(--md-sys-color-outline-variant);
      background: var(--md-sys-color-surface-container-lowest);
      color: var(--md-sys-color-on-surface);
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 0.75rem; white-space: nowrap; cursor: pointer;
    }
    .top3-item:hover { background: var(--md-sys-color-surface-container-high); }
    .top3-item b { font-weight: 600; max-width: 92px; overflow: hidden; text-overflow: ellipsis; }
    .top3-item span { font-family: var(--md-sys-typescale-mono); font-weight: 700; color: var(--md-sys-color-primary); }

    /* ==========================================================================
       5. M3 SEARCH BAR & FILTER / SORT CHIPS
       ========================================================================== */
    .m3-search-bar {
      background: var(--md-sys-color-surface-container-high);
      border-radius: var(--md-sys-shape-corner-full);
      height: 48px; padding: 0 16px;
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 10px;
      transition: background 0.15s, box-shadow 0.15s;
    }
    .m3-search-bar:focus-within {
      background: var(--md-sys-color-surface-container-lowest);
      box-shadow: 0 0 0 2px var(--md-sys-color-primary);
    }
    .m3-search-bar input {
      border: none; background: transparent; outline: none; width: 100%;
      font-size: 0.94rem; color: var(--md-sys-color-on-surface);
    }
    .m3-search-bar input:focus-visible { outline: none; }
    .search-reset {
      width: 32px; height: 32px; border-radius: 50%; border: none;
      background: transparent; color: var(--md-sys-color-on-surface-variant);
      cursor: pointer; display: none; align-items: center; justify-content: center;
    }

    .chip-strip {
      display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none;
      padding: 2px 0 8px 0; align-items: center;
    }
    .chip-strip::-webkit-scrollbar { display: none; }

    /* M3 Filter Chip (8dp corner radius, check mark when selected) */
    .filter-chip {
      height: 34px; padding: 0 12px;
      border-radius: var(--md-sys-shape-corner-small);
      border: 1px solid var(--md-sys-color-outline);
      background: transparent;
      color: var(--md-sys-color-on-surface-variant);
      font-size: 0.8rem; font-weight: 600;
      display: inline-flex; align-items: center; gap: 6px;
      white-space: nowrap; cursor: pointer; user-select: none;
    }
    .filter-chip:hover { background: var(--md-sys-color-surface-container); }
    .filter-chip[aria-pressed="true"] {
      background: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
      border-color: transparent;
    }
    .filter-chip[aria-pressed="true"]::before {
      content: "✓"; font-weight: 800; font-size: 0.82rem;
    }
    .chip-divider { width: 1px; height: 22px; background: var(--md-sys-color-outline-variant); flex-shrink: 0; }

    /* ==========================================================================
       6. DEVICE CARDS (M3 Outlined / Elevated Containment)
       ========================================================================== */
    .error-banner {
      background: var(--md-sys-color-error-container);
      color: var(--md-sys-color-on-error-container);
      border-radius: var(--md-sys-shape-corner-medium);
      padding: 12px 16px; margin-bottom: 12px;
      display: none; justify-content: space-between; align-items: center; gap: 12px;
      font-size: 0.84rem; font-weight: 600;
    }

    .cards-grid {
      display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 4px;
    }
    @media (min-width: 680px) { .cards-grid { grid-template-columns: repeat(2, 1fr); } }

    .device-card {
      background: var(--md-sys-color-surface-container-lowest);
      border: 1px solid var(--md-sys-color-outline-variant);
      border-radius: var(--md-sys-shape-corner-medium);
      padding: 14px 16px;
      display: flex; flex-direction: column; gap: 10px;
      contain: content; cursor: pointer; position: relative; user-select: none;
      transition: background 0.15s var(--md-sys-motion-easing-standard);
    }
    .device-card:hover { background: var(--md-sys-color-surface-container-low); }
    .device-card.offline {
      background: var(--md-sys-color-surface-container-low);
      opacity: 0.72;
    }
    .device-card.pinned {
      border-color: var(--md-sys-color-primary);
      border-width: 1.5px;
    }
    .device-card.selected {
      background: var(--md-sys-color-primary-container);
      border-color: var(--md-sys-color-primary);
    }

    /* Card Row 1: Identity + M3 Switch */
    .card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
    .identity-group { display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1; }

    .select-checkbox {
      width: 22px; height: 22px; border-radius: 4px;
      border: 2px solid var(--md-sys-color-primary);
      display: none; align-items: center; justify-content: center;
      font-size: 0.85rem; font-weight: 900; flex-shrink: 0;
      background: var(--md-sys-color-surface-container-lowest);
      color: var(--md-sys-color-primary);
    }
    .select-mode .select-checkbox { display: flex; }
    .device-card.selected .select-checkbox {
      background: var(--md-sys-color-primary);
      color: var(--md-sys-color-on-primary);
    }

    .avatar-trigger {
      width: 44px; height: 44px; border-radius: var(--md-sys-shape-corner-medium);
      background: var(--md-sys-color-surface-container);
      color: var(--md-sys-color-on-surface);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem; border: none; cursor: pointer; flex-shrink: 0; position: relative;
    }
    .avatar-trigger:active { transform: scale(0.92); }
    .pin-dot {
      position: absolute; top: -4px; left: -4px; width: 18px; height: 18px;
      border-radius: 50%; background: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary);
      font-size: 0.65rem; display: none; align-items: center; justify-content: center;
    }
    .device-card.pinned .pin-dot { display: flex; }

    .title-stack { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .title-line { display: flex; align-items: center; gap: 4px; min-width: 0; }
    .dev-title {
      font-size: 0.96rem; font-weight: 700; white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis;
    }
    .rename-btn {
      width: 28px; height: 28px; border-radius: 50%;
      border: none; background: transparent; color: var(--md-sys-color-on-surface-variant);
      font-size: 0.85rem; cursor: pointer; flex-shrink: 0;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .rename-btn:hover { background: var(--md-sys-color-surface-container-highest); }

    .subtitle-line {
      font-size: 0.75rem; color: var(--md-sys-color-on-surface-variant);
      display: flex; align-items: center; gap: 6px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* Official M3 Switch (52x32dp) */
    .switch-control { display: flex; flex-direction: column; align-items: center; gap: 2px; flex-shrink: 0; }
    .m3-switch { position: relative; display: inline-block; width: 52px; height: 32px; }
    .m3-switch input { opacity: 0; width: 0; height: 0; }
    .m3-switch-track {
      position: absolute; inset: 0;
      background: var(--md-sys-color-surface-container-highest);
      border: 2px solid var(--md-sys-color-outline);
      border-radius: var(--md-sys-shape-corner-full);
      cursor: pointer; transition: background 0.15s, border-color 0.15s;
    }
    .m3-switch-track::before {
      content: ""; position: absolute; height: 16px; width: 16px; left: 6px; bottom: 6px;
      background: var(--md-sys-color-outline);
      border-radius: 50%; transition: transform 0.16s var(--md-sys-motion-easing-standard);
    }
    .m3-switch input:checked + .m3-switch-track {
      background: var(--md-sys-color-error);
      border-color: var(--md-sys-color-error);
    }
    .m3-switch input:checked + .m3-switch-track::before {
      transform: translateX(20px); width: 24px; height: 24px; bottom: 2px; left: 2px;
      background: var(--md-sys-color-on-error);
    }
    .switch-caption { font-size: 0.62rem; font-weight: 700; color: var(--md-sys-color-on-surface-variant); }

    /* Semantic Assist Badges */
    .tags-cluster { display: flex; gap: 6px; flex-wrap: wrap; }
    .assist-tag {
      font-size: 0.68rem; font-weight: 700; padding: 2px 8px;
      border-radius: var(--md-sys-shape-corner-extra-small);
      background: var(--md-sys-color-surface-container);
      color: var(--md-sys-color-on-surface-variant);
    }
    .assist-tag.group { background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container); }
    .assist-tag.priv { background: var(--md-sys-color-tertiary-container); color: var(--md-sys-color-on-tertiary-container); }
    .assist-tag.qos { background: var(--md-sys-color-warning-container); color: var(--md-sys-color-on-warning-container); }
    .assist-tag.sched { background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); }
    .assist-tag.blocked { background: var(--md-sys-color-error-container); color: var(--md-sys-color-on-error-container); }

    @keyframes pulse3 { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
